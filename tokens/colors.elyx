  on-success: neutral-1,
  success-bg: green-3,
  success-border: green-7,
  success-text: green-11,
  // États interactifs (théorie Radix : survol = step 4, pressé = step 5, jamais la couleur seule)
  state-hover: neutral-4,
  state-pressed: neutral-5,
  cta-pressed: lime-11,
  light: neutral-12,
  light-hover: neutral-11,
  light-pressed: neutral-10,
