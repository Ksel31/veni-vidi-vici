  lime-7: rgb(28.6275%, 38.43%, 19.2157%),
  lime-8: rgb(34.1176%, 45.88%, 21.96%),
  lime-9: rgb(66.6667%, 100%, 13.33%),
  lime-10: rgb(83.1373%, 100%, 43.92%),
  lime-11: rgb(74.1176%, 89.8%, 42.35%),
  lime-12: rgb(89.0196%, 96.86%, 72.94%),
  // Échelle red
  red-1: rgb(9.8%, 6.6667%, 6.6667%),
  red-2: rgb(12.549%, 7.45%, 7.84%),
  red-3: rgb(23.1373%, 7.0588%, 9.8%),
  red-4: rgb(31.37%, 5.88%, 10.98%),
  red-5: rgb(38.0392%, 8.6275%, 13.7255%),
  red-6: rgb(44.7059%, 13.7255%, 17.6471%),
  red-7: rgb(54.9%, 20%, 22.7451%),
  red-8: rgb(70.98%, 27.0588%, 28.2353%),
  red-9: rgb(89.8%, 28.2353%, 30.1961%),
  red-10: rgb(92.549%, 36.47%, 36.86%),
