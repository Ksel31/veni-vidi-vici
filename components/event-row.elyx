use "fonts/ROYALHefanaRegular.woff"
use "fonts/Archivo.ttf"

import "tokens/colors.elyx" as c
import "tokens/lengths.elyx" as l
import "tokens/fonts.elyx" as f

// Ligne d'event à l'intérieur d'une carte groupée. Nom en Archivo gras pour rester lisible, compte à rebours en pastille rose.
// Le type (concert ou festival) est dans la ligne d'infos.
export eventRow = frame {
  left: 0px,
  top: 0px,
  width: 100%,
  height: .auto,
  layout: {align-items: .center, item-gap: l.lengths.space-m},
  padding: [12px, 0px],
  children: [info, countdown],

  info = frame {
    width: 100%,
    height: .auto,
    layout: {direction: .column, item-gap: 4px},
    children: [eventTitle, eventMeta, ticketState],

    eventTitle = text {
      width: 100%,
      fill: c.colors.ink,
      contents: "Titre",
      font-size: 20,
      font-family: f.fonts.body,
      font-style: "Bold"
    }

    eventMeta = text {
      width: 100%,
      fill: c.colors.ink,
      contents: "Concert | Date | Lieu",
      font-size: 14,
      font-family: f.fonts.body
    }

    ticketState = text {
      width: 100%,
      fill: c.colors.ink,
      contents: "Billet",
      font-size: 14,
      font-family: f.fonts.body,
      font-style: "Bold"
    }
  }

  countdown = frame {
    width: .auto,
    height: .auto,
    layout: {justify-content: .center, align-items: .center},
    fill: c.colors.surface-pink,
    corner-radius: l.lengths.radius-s,
    padding: [8px, 14px],
    children: countdownLabel,

    countdownLabel = text {
      fill: c.colors.ink,
      contents: "Dans 0 jours",
      font-size: 14,
      font-family: f.fonts.body,
      font-style: "Bold"
    }
  }
}
