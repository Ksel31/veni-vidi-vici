use "fonts/CabinetGrotesk-Variable.ttf"

import "images/logo-white.svg" as logoImage
import "icons/lucide/ticket.svg" as ticketIcon
import "icons/lucide/chevron-right.svg" as chevronRight
import "tokens/colors.elyx" as c
import "tokens/lengths.elyx" as l
import "tokens/fonts.elyx" as f

// Onboarding du compte vide : trois écrans plein cadre à swiper, une idée par écran. Il ne s'affiche qu'une fois par compte
// et jamais sur le compte démo. Les écrans assemblent ces briques : haut (logo + « Passer »), contenu, points de progression.
// Haut de l'écran : logo à gauche (premier écran seulement), « Passer » à droite.
export onboardingTop = frame {
  left: 0px,
  top: 0px,
  width: 100%,
  height: .auto,
  layout: {justify-content: .space-between, align-items: .center},
  children: [logo, skip],

  logo = asset {
    width: 150px,
    height: 53px,
    contents: logoImage
  }

  skip = frame {
    width: .auto,
    height: l.lengths.tap,
    layout: {justify-content: .center, align-items: .center},
    padding: [0px, 4px],
    children: skipLabel,

    skipLabel = text {
      fill: c.colors.text-on-dark,
      contents: "Passer",
      font-size: 16,
      font-family: f.fonts.ui,
      font-style: "Medium"
    }
  }
}

// Contenu d'une étape : gros disque clair + icône noire, petite ligne d'accueil (premier écran seulement), titre, phrase.
export onboardingContent = frame {
  left: 0px,
  top: 200px,
  width: 100%,
  height: .auto,
  layout: {direction: .column, item-gap: 24px},
  children: [disc, texts],

  disc = frame {
    width: 88px,
    height: 88px,
    layout: {justify-content: .center, align-items: .center},
    fill: c.colors.light,
    corner-radius: 44px,
    children: glyph,

    glyph = asset {
      width: 44px,
      height: 44px,
      fill: c.colors.neutral-1,
      contents: ticketIcon
    }
  }

  texts = frame {
    width: 100%,
    height: .auto,
    layout: {direction: .column, item-gap: 10px},
    children: [eyebrow, stepTitle, stepBody],

    eyebrow = text {
      width: 100%,
      display: .none,
      fill: c.colors.text-on-dark,
      contents: "Bienvenue dans Venidici !",
      font-size: 18,
      font-family: f.fonts.ui,
      font-style: "Medium"
    }

    stepTitle = text {
      width: 100%,
      fill: c.colors.text-on-dark,
      contents: "Ajoute tes events",
      font-size: 44,
      font-family: f.fonts.ui,
      font-style: "Medium",
      line-height: 1,
      letter-spacing: -3%
    }

    stepBody = text {
      width: 100%,
      fill: c.colors.text-on-dark,
      contents: "Concerts et festivals à venir, avec billet et line-up.",
      font-size: 18,
      font-family: f.fonts.ui,
      font-style: "Regular",
      line-height: 1.3
    }
  }
}

// Points de progression : le point actif est une pilule claire plus longue (la forme porte l'état, pas seulement la couleur).
// Base = étape 1 ; variantes pour les étapes 2 et 3.
export pageDots = frame {
  left: 0px,
  top: 400px,
  width: .auto,
  height: 8px,
  layout: {align-items: .center, item-gap: 8px},
  children: [dot1, dot2, dot3],

  dot1 = frame {
    width: 24px,
    height: 8px,
    fill: c.colors.light,
    corner-radius: 4px
  }

  dot2 = frame {
    width: 8px,
    height: 8px,
    fill: c.colors.text-on-dark-muted,
    corner-radius: 4px
  }

  dot3 = frame {
    width: 8px,
    height: 8px,
    fill: c.colors.text-on-dark-muted,
    corner-radius: 4px
  }
}

@variant
export pageDots2 = frame : pageDots {
  left: 200px,
  top: 400px,

  dot1 {
    fill[0].color: c.colors.text-on-dark-muted,
    width: 8px
  }

  dot2 {
    fill[0].color: c.colors.light,
    width: 24px
  }
}

@variant
export pageDots3 = frame : pageDots {
  left: 400px,
  top: 400px,

  dot1 {
    fill[0].color: c.colors.text-on-dark-muted,
    width: 8px
  }

  dot3 {
    fill[0].color: c.colors.light,
    width: 24px
  }
}

// Flèche discrète des étapes 1 et 2 : invite à swiper, sans bouton « Suivant ». À poser au bord droit, à mi-hauteur de
// l'écran (ignore-stack, top 398 px sur 844 px). Zone touchable de 48 px.
export swipeHint = frame {
  left: 0px,
  top: 500px,
  width: 48px,
  height: 48px,
  layout: {justify-content: .center, align-items: .center},
  children: arrowGlyph,

  arrowGlyph = asset {
    width: 28px,
    height: 28px,
    fill: c.colors.text-on-dark,
    contents: chevronRight
  }
}
