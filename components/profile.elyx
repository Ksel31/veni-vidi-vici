use "fonts/CabinetGrotesk-Variable.ttf"

import "icons/lucide/search.svg" as searchIcon
import "icons/lucide/chevron-right.svg" as chevronIcon
import "icons/lucide/pencil.svg" as pencilIcon
import "tokens/colors.elyx" as c
import "tokens/lengths.elyx" as l
import "tokens/fonts.elyx" as f

// Un chiffre clé : valeur en grand, libellé dessous. Texte blanc, pour la zone sombre sur photo.
export statBlock = frame {
  left: 0px,
  top: 100px,
  width: 100%,
  height: .auto,
  layout: {direction: .column, item-gap: 2px},
  children: [statValue, statLabel],

  statValue = text {
    fill: c.colors.text-on-dark,
    contents: "0",
    font-size: 26,
    font-family: f.fonts.ui,
    font-style: "Medium",
    line-height: 1
  }

  statLabel = text {
    fill: c.colors.text-on-dark,
    contents: "Libellé",
    font-size: 14,
    font-family: f.fonts.ui,
    font-style: "Regular"
  }
}

// Bouton rond de recherche : gris clair, loupe noire.
export searchButton = frame {
  left: 0px,
  top: 0px,
  width: 48px,
  height: 48px,
  layout: {justify-content: .center, align-items: .center},
  fill: c.colors.light,
  corner-radius: 24px,
  children: searchGlyph,

  searchGlyph = asset {
    width: 24px,
    height: 24px,
    fill: c.colors.neutral-1,
    contents: searchIcon
  }
}

// États du bouton de recherche : survol light-hover, pressé light-pressed, focus anneau, désactivé gris.
@variant
export searchButtonHover = frame : searchButton {
  left: 300px,
  top: 0px,
  fill[0].color: c.colors.light-hover
}

@variant
export searchButtonPressed = frame : searchButton {
  left: 300px,
  top: 100px,
  fill[0].color: c.colors.light-pressed
}

@variant
export searchButtonFocus = frame : searchButton {
  left: 300px,
  top: 200px,
  border[0].color: c.colors.focus-ring,
  border[0].position: .outside,
  border[0].width: l.lengths.focus-ring-width
}

@variant
export searchButtonDisabled = frame : searchButton {
  left: 300px,
  top: 300px,
  fill[0].color: c.colors.disabled-bg,

  searchGlyph {
    fill[0].color: c.colors.disabled-text
  }
}

// Profil en tête de l'accueil : avatar seul (ni prénom ni pseudo ; il ouvre le profil) + recherche, puis trois chiffres clés séparés par un filet.
export profileHeader = frame {
  left: 0px,
  top: 200px,
  width: 100%,
  height: .auto,
  layout: {direction: .column, item-gap: 14px},
  padding: [0px, 6px],
  children: [identity, stats],

  identity = frame {
    width: 100%,
    height: .auto,
    layout: {justify-content: .space-between, align-items: .center},
    children: [who, search],

    who = frame {
      width: .auto,
      height: .auto,
      layout: {align-items: .center, item-gap: 12px},
      children: avatar,

      avatar = frame {
        width: 52px,
        height: 52px,
        layout: {justify-content: .center, align-items: .center},
        fill: c.colors.neutral-12,
        border: {color: c.colors.text-on-dark, width: 2px},
        corner-radius: 26px,
        children: avatarInitial,

        avatarInitial = text {
          fill: c.colors.neutral-1,
          contents: "A",
          font-size: 24,
          font-family: f.fonts.ui,
          font-style: "Medium"
        }
      }

    }

    search = frame : searchButton {}
  }

  stats = frame {
    width: 100%,
    height: .auto,
    layout: {direction: .row},
    children: [statUpcoming, statSeen, statBands],

    statUpcoming = frame : statBlock {
      statValue {
        contents: "4"
      }

      statLabel {
        contents: "À venir"
      }
    }

    statSeen = frame : statBlock {
      padding-top: 0px,
      padding-left: 16px,
      padding-bottom: 0px,
      padding-right: 0px,
      border[0].color: c.colors.divider,
      border[0].sides: .left,

      statLabel {
        contents: "Events vus"
      }

      statValue {
        contents: "12"
      }
    }

    statBands = frame : statBlock {
      padding-top: 0px,
      padding-left: 16px,
      padding-bottom: 0px,
      padding-right: 0px,
      border[0].color: c.colors.divider,
      border[0].sides: .left,

      statLabel {
        contents: "Groupes vus"
      }

      statValue {
        contents: "31"
      }
    }
  }
}

// Ligne de réglage du profil : libellé, valeur grisée et chevron. Filet en haut ; masquer-le (border) sur la 1re ligne d'une carte.
export settingRow = frame {
  left: 0px,
  top: 300px,
  width: 100%,
  height: 48px,
  layout: {align-items: .center, item-gap: 8px},
  border[0].color: c.colors.divider,
  border[0].sides: .top,
  children: [rowLabel, rowValue, rowChevron],

  rowLabel = text {
    width: 100%,
    fill: c.colors.text-on-dark,
    contents: "Réglage",
    font-size: 16,
    font-family: f.fonts.ui,
    font-style: "Regular"
  }

  rowValue = text {
    fill: c.colors.text-on-dark-muted,
    contents: "Valeur",
    font-size: 14,
    font-family: f.fonts.ui,
    font-style: "Regular"
  }

  rowChevron = asset {
    width: 20px,
    height: 20px,
    fill: c.colors.text-on-dark-muted,
    contents: chevronIcon
  }
}

// Grand avatar du profil : initiale + pastille crayon (modifiable).
export avatarLarge = frame {
  left: 0px,
  top: 400px,
  width: 88px,
  height: 88px,
  layout: {justify-content: .center, align-items: .center},
  fill: c.colors.neutral-12,
  corner-radius: 44px,
  overflow: .visible,
  children: [avatarInitial, editBadge],

  avatarInitial = text {
    fill: c.colors.neutral-1,
    contents: "A",
    font-size: 40,
    font-family: f.fonts.ui,
    font-style: "Medium"
  }

  editBadge = frame {
    right: -4px,
    bottom: -4px,
    width: 32px,
    height: 32px,
    ignore-stack: .true,
    layout: {justify-content: .center, align-items: .center},
    fill: c.colors.neutral-1,
    border: {color: c.colors.text-on-dark, width: 2px},
    corner-radius: 16px,
    children: editGlyph,

    editGlyph = asset {
      width: 16px,
      height: 16px,
      fill: c.colors.text-on-dark,
      contents: pencilIcon
    }
  }
}
