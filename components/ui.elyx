use "fonts/CabinetGrotesk-Variable.ttf"
use "fonts/Archivo.ttf"

import "icons/lucide/check.svg" as checkIcon
import "icons/lucide/x.svg" as crossIcon
import "icons/lucide/arrow-left.svg" as arrowLeftIcon
import "icons/lucide/chevron-right.svg" as chevronRight
import "icons/lucide/chevron-up.svg" as chevronUp
import "icons/lucide/clock.svg" as clockIcon
import "icons/lucide/music.svg" as musicIcon
import "icons/lucide/search.svg" as searchIcon
import "icons/lucide/thumbs-up.svg" as thumbsUpIcon
import "icons/lucide/upload.svg" as uploadIcon
import "icons/lucide/file-text.svg" as fileIcon
import "icons/lucide/plus.svg" as plusIcon
import "icons/lucide/crown.svg" as crownIcon
import "icons/lucide/trash.svg" as trashIcon
import "tokens/colors.elyx" as c
import "tokens/lengths.elyx" as l
import "tokens/fonts.elyx" as f

// Briques des écrans secondaires (connexion, ajout, fiche event, historique). Tout est en verre sombre sur photo,
// texte blanc ; le vert reste réservé au billet et au « + ». Bouton principal = pilule claire, secondaire = verre + filet.
// Carte en verre sombre : conteneur des sections de formulaire et de la fiche
export glassCard = frame {
  left: 0px,
  top: 0px,
  width: 100%,
  height: .auto,
  layout: {direction: .column, item-gap: 14px},
  fill: c.colors.glass,
  border: {
    linear-gradient: {
      from: point(17.1389%, 10.85%),
      to: point(55.06%, 100%),
      stops: [
        stop(75.79%, c.colors.glass-edge-dark),
        stop(8.98%, c.colors.glass-edge-light)
      ]
    }
  },
  filter: {
    type: .background-blur,
    start: {position: point(50%, 59.9264%), radius: 0px},
    end: {position: point(50%, 5.71%), radius: l.lengths.glass-blur}
  },
  corner-radius: l.lengths.radius-xl,
  overflow: .visible,
  padding: l.lengths.space-m,
  children: cardTitle,

  cardTitle = text {
    width: 100%,
    fill: c.colors.text-on-dark,
    contents: "Titre de section",
    font-size: 18,
    font-family: f.fonts.ui,
    font-style: "Medium"
  }
}

// Carte pliable (fiches en lecture) : une glassCard avec une flèche en haut à droite, zone tactile 44 px.
// Dépliée = flèche vers le haut. Repliée = flèche vers le bas et seul le titre reste visible
// (on masque le contenu inséré avec `display: .none` dans l'instance).
export foldCard = frame : glassCard {
  left: 600px,
  top: 0px,
  overrides: [insert(foldToggle, after = glassCard.cardTitle)],

  foldToggle = frame {
    top: 4px,
    right: 4px,
    width: l.lengths.tap,
    height: l.lengths.tap,
    ignore-stack: .true,
    layout: {justify-content: .center, align-items: .center},
    corner-radius: 22px,
    children: foldGlyph,

    foldGlyph = asset {
      width: 20px,
      height: 20px,
      fill: c.colors.text-on-dark,
      contents: chevronUp
    }
  }
}

// Petit texte d'aide ou de légende sous un titre
export hint = text {
  left: 1200px,
  top: 0px,
  width: 100%,
  fill: c.colors.text-on-dark-muted,
  contents: "Texte d'aide",
  font-size: 14,
  font-family: f.fonts.ui,
  font-style: "Regular",
  line-height: 1.3
}

// Bouton principal : pilule claire, texte noir (l'encre du projet sombre = neutral-1)
export primaryButton = frame {
  left: 0px,
  top: 200px,
  width: 100%,
  height: 52px,
  layout: {justify-content: .center, align-items: .center, item-gap: 8px},
  fill: c.colors.cta,
  corner-radius: l.lengths.radius-l,
  children: [buttonGlyph, buttonLabel],

  buttonGlyph = asset {
    width: 22px,
    height: 22px,
    fill: c.colors.neutral-1,
    contents: checkIcon
  }

  buttonLabel = text {
    fill: c.colors.neutral-1,
    contents: "Continuer",
    font-size: 16,
    font-family: f.fonts.ui,
    font-style: "Medium"
  }
}

// Bouton secondaire : verre dense + filet clair
export secondaryButton = frame {
  left: 600px,
  top: 200px,
  width: 100%,
  height: 52px,
  layout: {justify-content: .center, align-items: .center, item-gap: 8px},
  fill: c.colors.glass-strong,
  border: {color: c.colors.border, width: 1.5px},
  corner-radius: l.lengths.radius-l,
  children: [buttonGlyph, buttonLabel],

  buttonGlyph = asset {
    width: 22px,
    height: 22px,
    fill: c.colors.text-on-dark,
    contents: crossIcon
  }

  buttonLabel = text {
    fill: c.colors.text-on-dark,
    contents: "Annuler",
    font-size: 16,
    font-family: f.fonts.ui,
    font-style: "Medium"
  }
}

// Champ de saisie : libellé au-dessus, valeur dans une boîte sombre, icône Lucide à gauche
export field = frame {
  left: 0px,
  top: 400px,
  width: 100%,
  height: .auto,
  layout: {direction: .column, item-gap: 6px},
  overflow: .visible,
  children: [fieldLabel, fieldBox],

  fieldLabel = text {
    fill: c.colors.text-on-dark-muted,
    contents: "Libellé",
    font-size: 13,
    font-family: f.fonts.ui,
    font-style: "Medium"
  }

  fieldBox = frame {
    width: 100%,
    height: 48px,
    layout: {align-items: .center, item-gap: 10px},
    fill: c.colors.surface-dark,
    border: c.colors.glass-border,
    corner-radius: l.lengths.radius-m,
    overflow: .visible,
    padding: [0px, 14px],
    children: [fieldGlyph, fieldValue],

    fieldGlyph = asset {
      width: 20px,
      height: 20px,
      fill: c.colors.text-on-dark-muted,
      contents: searchIcon
    }

    fieldValue = text {
      width: 100%,
      fill: c.colors.text-on-dark,
      contents: "Valeur",
      font-size: 14,
      font-family: f.fonts.input,
      font-style: "Regular"
    }
  }
}

// Champ vide : la valeur devient un texte d'aide grisé
@variant
export fieldEmpty = frame : field {
  left: 600px,
  top: 400px,

  fieldBox {
    fieldValue {
      fill[0].color: c.colors.text-on-dark-muted
    }
  }
}

// Puce de choix (type de passage, année, jour…) : inactive = verre + filet, active = pilule claire
export chip = frame {
  left: 0px,
  top: 600px,
  width: .auto,
  height: l.lengths.tap,
  layout: {justify-content: .center, align-items: .center, item-gap: 8px},
  fill: c.colors.glass-strong,
  border: c.colors.border,
  corner-radius: l.lengths.radius-m,
  padding: [0px, 16px],
  children: chipLabel,

  chipLabel = text {
    fill: c.colors.text-on-dark,
    contents: "2025",
    font-size: 14,
    font-family: f.fonts.ui,
    font-style: "Medium"
  }
}

@variant
export chipOn = frame : chip {
  left: 600px,
  top: 600px,
  border[0].color: c.colors.light,
  fill[0].color: c.colors.light,

  chipLabel {
    fill[0].color: c.colors.neutral-1
  }
}

// Ligne cochable (jours faits, groupes vus) : case + libellé + détail. Base = cochée ; « Off » = case vide.
export checkRow = frame {
  left: 0px,
  top: 800px,
  width: 100%,
  height: .auto,
  layout: {align-items: .center, item-gap: 12px},
  fill: c.colors.surface-dark,
  border: c.colors.glass-border,
  corner-radius: l.lengths.radius-m,
  padding: [10px, 12px],
  children: [checkBox, checkTexts],

  checkBox = frame {
    width: 24px,
    height: 24px,
    layout: {justify-content: .center, align-items: .center},
    fill: c.colors.light,
    border: {color: c.colors.light, width: 2px},
    corner-radius: l.lengths.radius-s,
    children: checkGlyph,

    checkGlyph = asset {
      width: 18px,
      height: 18px,
      fill: c.colors.neutral-1,
      contents: checkIcon
    }
  }

  checkTexts = frame {
    width: 100%,
    height: .auto,
    layout: {direction: .column, item-gap: 1px},
    children: [checkTitle, checkMeta],

    checkTitle = text {
      width: 100%,
      fill: c.colors.text-on-dark,
      contents: "Groupe",
      font-size: 16,
      font-family: f.fonts.ui,
      font-style: "Medium"
    }

    checkMeta = text {
      width: 100%,
      fill: c.colors.text-on-dark-muted,
      contents: "Détail",
      font-size: 13,
      font-family: f.fonts.ui,
      font-style: "Regular"
    }
  }
}

@variant
export checkRowOff = frame : checkRow {
  left: 600px,
  top: 800px,

  checkBox {
    fill[0].color: c.colors.neutral-1,
    border[0].color: c.colors.neutral-9,

    checkGlyph {
      display: .none
    }
  }
}

// Badge de statut : texte + icône, jamais la couleur seule. Base = « Vu » (vert), variantes « Raté » et « À confirmer ».
export statusBadge = frame {
  left: 0px,
  top: 1000px,
  width: .auto,
  height: .auto,
  layout: {justify-content: .center, align-items: .center, item-gap: 4px},
  fill: c.colors.success-bg,
  border: c.colors.success-border,
  corner-radius: l.lengths.radius-s,
  padding: [4px, 8px],
  children: [badgeGlyph, badgeLabel],

  badgeGlyph = asset {
    width: 16px,
    height: 16px,
    fill: c.colors.success-text,
    contents: checkIcon
  }

  badgeLabel = text {
    fill: c.colors.success-text,
    contents: "Vu",
    font-size: 14,
    font-family: f.fonts.ui,
    font-style: "Medium"
  }
}

@variant
export statusBadgeMissed = frame : statusBadge {
  left: 600px,
  top: 1000px,
  border[0].color: c.colors.danger-border,
  fill[0].color: c.colors.danger-bg,

  badgeGlyph {
    fill[0].color: c.colors.danger-text,
    contents: crossIcon
  }

  badgeLabel {
    fill[0].color: c.colors.danger-text,
    contents: "Raté"
  }
}

@variant
export statusBadgePending = frame : statusBadge {
  left: 1200px,
  top: 1000px,
  border[0].color: c.colors.warning-border,
  fill[0].color: c.colors.warning-bg,

  badgeGlyph {
    fill[0].color: c.colors.warning-text,
    contents: clockIcon
  }

  badgeLabel {
    fill[0].color: c.colors.warning-text,
    contents: "À confirmer"
  }
}

// Ligne d'event passé (historique) : date à gauche, titre + lieu, badge de statut à droite. Même verre que eventRow.
export pastRow = frame {
  left: 0px,
  top: 1200px,
  width: 100%,
  height: .auto,
  layout: {align-items: .center, item-gap: 12px},
  fill: c.colors.glass,
  border: {
    linear-gradient: {
      from: point(17.1389%, 10.85%),
      to: point(55.06%, 100%),
      stops: [
        stop(75.79%, c.colors.glass-edge-dark),
        stop(8.98%, c.colors.glass-edge-light)
      ]
    }
  },
  filter: {
    type: .background-blur,
    start: {position: point(50%, 59.9264%), radius: 0px},
    end: {position: point(50%, 5.71%), radius: l.lengths.glass-blur}
  },
  corner-radius: l.lengths.radius-xl,
  overflow: .visible,
  padding: 12px,
  children: [dateBlock, info, status, deleteMark],

  dateBlock = frame {
    width: 60px,
    height: 60px,
    layout: {direction: .column, justify-content: .center, align-items: .center},
    fill: c.colors.surface-dark,
    corner-radius: l.lengths.radius-m,
    children: [dateDay, dateMonth],

    dateDay = text {
      fill: c.colors.neutral-12,
      contents: "12",
      font-size: 24,
      font-family: f.fonts.ui,
      font-style: "Medium",
      line-height: 1
    }

    dateMonth = text {
      fill: c.colors.neutral-12,
      contents: "DÉC",
      font-size: 14,
      font-family: f.fonts.ui,
      font-style: "Medium",
      letter-spacing: 4%
    }
  }

  info = frame {
    width: 100%,
    height: .auto,
    layout: {direction: .column, item-gap: 2px},
    children: [eventTitle, eventMeta],

    eventTitle = text {
      width: 100%,
      fill: c.colors.neutral-12,
      contents: "Titre",
      font-size: 18,
      font-family: f.fonts.ui,
      font-style: "Medium"
    }

    eventMeta = text {
      width: 100%,
      fill: c.colors.text-on-dark-muted,
      contents: "Lieu",
      font-size: 14,
      font-family: f.fonts.ui,
      font-style: "Regular"
    }
  }

  status = frame : statusBadge {}

  // Croix discrète, coin haut droit. Masquée ici : l'historique l'affiche (olive-11, trait 2).
  deleteMark = asset {
    top: 10px,
    right: 10px,
    width: 12px,
    height: 12px,
    display: .none,
    ignore-stack: .true,
    fill: c.colors.text-on-dark-muted,
    contents: crossIcon
  }
}

// Event passé à confirmer (écran « À confirmer ») : carte en verre avec la question et les deux réponses.
export pendingCard = frame {
  left: 0px,
  top: 1750px,
  width: 100%,
  height: .auto,
  layout: {direction: .column, item-gap: 14px},
  fill: c.colors.glass,
  border: {
    linear-gradient: {
      from: point(17.1389%, 10.85%),
      to: point(55.06%, 100%),
      stops: [
        stop(75.79%, c.colors.glass-edge-dark),
        stop(8.98%, c.colors.glass-edge-light)
      ]
    }
  },
  filter: {
    type: .background-blur,
    start: {position: point(50%, 59.9264%), radius: 0px},
    end: {position: point(50%, 5.71%), radius: l.lengths.glass-blur}
  },
  corner-radius: l.lengths.radius-xl,
  padding: l.lengths.space-m,
  children: [head, actions],

  head = frame : pastRow {
    padding-top: 0px,
    padding-left: 0px,
    padding-bottom: 0px,
    padding-right: 0px,
    border[0].color: .transparent,
    fill[0].color: .transparent,

    status {
      display: .none
    }
  }

  actions = frame {
    width: 100%,
    height: .auto,
    layout: {item-gap: 12px},
    children: [missedButton, seenButton],

    missedButton = frame : secondaryButton {
      height: 48px,

      buttonLabel {
        contents: "Raté"
      }
    }

    seenButton = frame : primaryButton {
      height: 48px,

      buttonLabel {
        contents: "Vu"
      }
    }
  }
}

// Grand choix de type d'event (étape 1 de l'ajout) : disque clair + icône, titre, phrase, chevron
export typeCard = frame {
  left: 600px,
  top: 1750px,
  width: 100%,
  height: .auto,
  layout: {align-items: .center, item-gap: 16px},
  fill: c.colors.glass,
  border: {
    linear-gradient: {
      from: point(17.1389%, 10.85%),
      to: point(55.06%, 100%),
      stops: [
        stop(75.79%, c.colors.glass-edge-dark),
        stop(8.98%, c.colors.glass-edge-light)
      ]
    }
  },
  filter: {
    type: .background-blur,
    start: {position: point(50%, 59.9264%), radius: 0px},
    end: {position: point(50%, 5.71%), radius: l.lengths.glass-blur}
  },
  corner-radius: l.lengths.radius-xl,
  padding: 20px,
  children: [typeDisc, typeTexts, typeChevron],

  typeDisc = frame {
    width: 64px,
    height: 64px,
    layout: {justify-content: .center, align-items: .center},
    fill: c.colors.light,
    corner-radius: 32px,
    children: typeGlyph,

    typeGlyph = asset {
      width: 30px,
      height: 30px,
      fill: c.colors.neutral-1,
      contents: musicIcon
    }
  }

  typeTexts = frame {
    width: 100%,
    height: .auto,
    layout: {direction: .column, item-gap: 4px},
    children: [typeTitle, typeText],

    typeTitle = text {
      width: 100%,
      fill: c.colors.text-on-dark,
      contents: "Concert",
      font-size: 26,
      font-family: f.fonts.ui,
      font-style: "Medium",
      letter-spacing: -2%
    }

    typeText = text {
      width: 100%,
      fill: c.colors.text-on-dark-muted,
      contents: "Une soirée, une salle.",
      font-size: 14,
      font-family: f.fonts.ui,
      font-style: "Regular",
      line-height: 1.3
    }
  }

  typeChevron = asset {
    width: 24px,
    height: 24px,
    fill: c.colors.text-on-dark,
    contents: chevronRight
  }
}

// Ligne de groupe. Le rôle est une pastille ronde : couronne = tête d'affiche, micro = première partie.
// Le libellé (masqué) sert aux jours de festival (« Jeu 17 »), texte centré. La poignée est masquée hors formulaire.
export lineupRow = frame {
  left: 600px,
  top: 1200px,
  width: 100%,
  height: .auto,
  layout: {align-items: .center, item-gap: 8px},
  fill: c.colors.surface-dark,
  border: c.colors.glass-border,
  corner-radius: l.lengths.radius-m,
  overflow: .visible,
  padding: [4px, 12px],
  children: [dragHandle, bandName, bandRole, bandRemove],

  dragHandle = frame {
    width: l.lengths.tap,
    height: l.lengths.tap,
    display: .none,
    layout: {
      direction: .column,
      justify-content: .center,
      align-items: .center,
      item-gap: 4px
    },
    children: [grip1, grip2, grip3],

    grip1 = frame {
      width: 18px,
      height: 2px,
      fill: c.colors.text-on-dark-muted,
      corner-radius: 1px
    }

    grip2 = frame {
      width: 18px,
      height: 2px,
      fill: c.colors.text-on-dark-muted,
      corner-radius: 1px
    }

    grip3 = frame {
      width: 18px,
      height: 2px,
      fill: c.colors.text-on-dark-muted,
      corner-radius: 1px
    }
  }

  bandName = text {
    width: 100%,
    fill: c.colors.text-on-dark,
    contents: "Groupe",
    font-size: 16,
    font-family: f.fonts.ui,
    font-style: "Medium"
  }

  bandRole = frame {
    width: 32px,
    height: 32px,
    layout: {justify-content: .center, align-items: .center},
    fill: c.colors.light,
    corner-radius: 32px,
    children: [bandRoleGlyph, bandRoleLabel],

    bandRoleGlyph = asset {
      width: 18px,
      height: 18px,
      fill: c.colors.neutral-1,
      contents: crownIcon
    }

    bandRoleLabel = text {
      display: .none,
      fill: c.colors.neutral-1,
      contents: "Jeu 17",
      font-size: 13,
      font-family: f.fonts.ui,
      font-style: "Medium",
      line-height: 1
    }
  }

  bandRemove = frame {
    width: l.lengths.tap,
    height: l.lengths.tap,
    layout: {justify-content: .center, align-items: .center},
    children: bandRemoveGlyph,

    bandRemoveGlyph = asset {
      width: 20px,
      height: 20px,
      fill: c.colors.text-on-dark-muted,
      contents: crossIcon
    }
  }
}

// Pouce (avis global ou par groupe) : bouton en verre avec libellé ; sélectionné = pilule claire
export thumbButton = frame {
  left: 1200px,
  top: 600px,
  width: .auto,
  height: 44px,
  layout: {justify-content: .center, align-items: .center, item-gap: 8px},
  fill: c.colors.glass-strong,
  border: c.colors.border,
  corner-radius: l.lengths.radius-m,
  padding: [0px, 16px],
  children: [thumbGlyph, thumbLabel],

  thumbGlyph = asset {
    width: 20px,
    height: 20px,
    fill: c.colors.text-on-dark,
    contents: thumbsUpIcon
  }

  thumbLabel = text {
    fill: c.colors.text-on-dark,
    contents: "J'ai aimé",
    font-size: 14,
    font-family: f.fonts.ui,
    font-style: "Medium"
  }
}

@variant
export thumbButtonOn = frame : thumbButton {
  left: 1800px,
  top: 600px,
  border[0].color: c.colors.light,
  fill[0].color: c.colors.light,

  thumbGlyph {
    fill[0].color: c.colors.neutral-1
  }

  thumbLabel {
    fill[0].color: c.colors.neutral-1
  }
}

// Zone d'envoi de fichier (billet PDF ou image) : cadre en pointillés, icône, consigne
export uploadBox = frame {
  left: 0px,
  top: 1450px,
  width: 100%,
  height: .auto,
  layout: {
    direction: .column,
    justify-content: .center,
    align-items: .center,
    item-gap: 6px
  },
  border: {color: c.colors.border, width: 1.5px, dash: [6px, 5px]},
  corner-radius: l.lengths.radius-m,
  padding: [18px, 12px],
  children: [uploadGlyph, uploadTitle, uploadHint],

  uploadGlyph = asset {
    width: 26px,
    height: 26px,
    fill: c.colors.text-on-dark,
    contents: uploadIcon
  }

  uploadTitle = text {
    fill: c.colors.text-on-dark,
    contents: "Ajouter le billet",
    font-size: 16,
    font-family: f.fonts.ui,
    font-style: "Medium"
  }

  // Texte d'aide : comme `hint` (14 px, Regular, gris secondaire), centré, sur toute la largeur pour passer à la ligne.
  uploadHint = text {
    width: 100%,
    fill: c.colors.text-on-dark-muted,
    contents: "PDF ou image.",
    font-size: 14,
    font-family: f.fonts.input,
    font-style: "Regular",
    line-height: 1.3,
    align: .center
  }
}

// Fichier déjà envoyé : icône, nom, taille, croix pour le retirer
export fileRow = frame {
  left: 1200px,
  top: 1200px,
  width: 100%,
  height: .auto,
  layout: {align-items: .center, item-gap: 12px},
  fill: c.colors.surface-dark,
  border: c.colors.glass-border,
  corner-radius: l.lengths.radius-m,
  padding: [10px, 12px],
  children: [fileGlyph, fileTexts, fileRemove],

  fileGlyph = asset {
    width: 24px,
    height: 24px,
    fill: c.colors.text-on-dark,
    contents: fileIcon
  }

  fileTexts = frame {
    width: 100%,
    height: .auto,
    layout: {direction: .column, item-gap: 1px},
    children: [fileName, fileMeta],

    fileName = text {
      width: 100%,
      fill: c.colors.text-on-dark,
      contents: "billet.pdf",
      font-size: 16,
      font-family: f.fonts.ui,
      font-style: "Medium"
    }

    fileMeta = text {
      width: 100%,
      fill: c.colors.text-on-dark-muted,
      contents: "PDF, 240 Ko",
      font-size: 13,
      font-family: f.fonts.ui,
      font-style: "Regular"
    }
  }

  fileRemove = asset {
    width: 20px,
    height: 20px,
    fill: c.colors.text-on-dark-muted,
    contents: crossIcon
  }
}

// Case « ajouter une photo » de la grille de souvenirs : même taille que les vignettes (100 px)
export photoAdd = frame {
  left: 600px,
  top: 1450px,
  width: 100px,
  height: 100px,
  layout: {justify-content: .center, align-items: .center},
  border: {color: c.colors.border, width: 1.5px, dash: [6px, 5px]},
  corner-radius: l.lengths.radius-m,
  children: photoAddGlyph,

  photoAddGlyph = asset {
    width: 28px,
    height: 28px,
    fill: c.colors.text-on-dark,
    contents: plusIcon
  }
}

// Bouton destructif : filet et texte rouge, fond transparent, icône poubelle. Sous « Modifier l'event ».
export dangerButton = frame {
  left: 1200px,
  top: 200px,
  width: 100%,
  height: 52px,
  layout: {justify-content: .center, align-items: .center, item-gap: 8px},
  border: {color: c.colors.danger-border, width: 1.5px},
  corner-radius: l.lengths.radius-l,
  children: [buttonGlyph, buttonLabel],

  buttonGlyph = asset {
    width: 22px,
    height: 22px,
    fill: c.colors.danger-text,
    contents: trashIcon
  }

  buttonLabel = text {
    fill: c.colors.danger-text,
    contents: "Supprimer l'event",
    font-size: 16,
    font-family: f.fonts.ui,
    font-style: "Medium"
  }
}

// Question de suppression : panneau opaque (plus le verre), pas un voile.
export deleteDialog = frame {
  left: 0px,
  top: 2250px,
  width: 358px,
  height: .auto,
  layout: {direction: .column, item-gap: 14px},
  fill: c.colors.glass-strong,
  border: {
    linear-gradient: {
      from: point(17.1389%, 10.85%),
      to: point(55.06%, 100%),
      stops: [
        stop(75.79%, c.colors.glass-edge-dark),
        stop(8.98%, c.colors.glass-edge-light)
      ]
    }
  },
  filter: {
    type: .background-blur,
    start: {position: point(50%, 59.9264%), radius: 0px},
    end: {position: point(50%, 5.71%), radius: l.lengths.glass-blur}
  },
  corner-radius: l.lengths.radius-xl,
  padding: l.lengths.space-m,
  children: [dialogTitle, dialogHint, dialogActions],

  dialogTitle = text {
    width: 100%,
    fill: c.colors.text-on-dark,
    contents: "Supprimer cet event ?",
    font-size: 18,
    font-family: f.fonts.ui,
    font-style: "Medium"
  }

  dialogHint = text : hint {
    left: 0px,
    top: 0px,
    contents: "L'event, ses groupes et son compte rendu seront effacés."
  }

  dialogActions = frame {
    width: 100%,
    height: .auto,
    layout: {item-gap: 8px},
    children: [cancel, confirm],

    cancel = frame : secondaryButton {
      buttonGlyph {
        display: .none
      }

      buttonLabel {
        contents: "Annuler"
      }
    }

    confirm = frame : primaryButton {
      buttonGlyph {
        contents: trashIcon
      }

      buttonLabel {
        contents: "Supprimer"
      }
    }
  }
}

// Même question, sur le voile noir (60 %) de l'historique et de la fiche.
export deleteConfirm = frame {
  left: 600px,
  top: 2250px,
  width: 390px,
  height: 280px,
  layout: {justify-content: .center, align-items: .center},
  fill: rgb(0%, 0%, 0%, 60%),
  corner-radius: 24px,
  padding: 16px,
  children: panel,

  panel = frame : deleteDialog {
    left: 0px,
    top: 0px
  }
}

// Toast après « Raté » sur À confirmer : 5 secondes, action « Annuler ».
export undoToast = frame {
  left: 0px,
  top: 2050px,
  width: 358px,
  height: .auto,
  layout: {
    justify-content: .space-between,
    align-items: .center,
    item-gap: 12px
  },
  fill: c.colors.surface-dark,
  border: c.colors.glass-border,
  corner-radius: l.lengths.radius-l,
  padding: [8px, 8px, 8px, 16px],
  children: [toastText, toastAction],

  toastText = text {
    width: 100%,
    fill: c.colors.text-on-dark,
    contents: "Event marqué comme raté",
    font-size: 15,
    font-family: f.fonts.ui,
    font-style: "Medium"
  }

  toastAction = frame {
    width: .auto,
    height: l.lengths.tap,
    layout: {justify-content: .center, align-items: .center},
    padding: [0px, 12px],
    children: toastActionLabel,

    toastActionLabel = text {
      fill: c.colors.cta,
      contents: "Annuler",
      font-size: 16,
      font-family: f.fonts.ui,
      font-style: "Medium"
    }
  }
}

// Toast d'information sans action (ex. « Event ajouté ») : même coque que le toast d'annulation, rien à annuler.
export infoToast = frame : undoToast {
  left: 600px,
  top: 2050px,
  height: 52px,
  overrides: [remove(undoToast.toastAction)],

  toastText {
    contents: "Event ajouté"
  }
}

// Ligne de festival repliée : nom Medium 16, pilule crème 24 px (zone 44) texte Medium 13, croix 16 dans un cercle 28.
export festivalBand = frame {
  left: 1800px,
  top: 1200px,
  width: 100%,
  height: .auto,
  layout: {align-items: .center, item-gap: 2px},
  fill: c.colors.surface-dark,
  border: c.colors.glass-border,
  corner-radius: l.lengths.radius-m,
  padding: [6px, 8px],
  children: [bandName, dayPill, bandRemove],

  bandName = text {
    width: 100%,
    fill: c.colors.text-on-dark,
    contents: "Groupe",
    font-size: 16,
    font-family: f.fonts.ui,
    font-style: "Medium"
  }

  dayPill = frame {
    width: .auto,
    height: l.lengths.tap,
    min-width: l.lengths.tap,
    layout: {justify-content: .center, align-items: .center},
    padding: [10px, 0px],
    children: dayFace,

    dayFace = frame {
      width: .auto,
      height: 24px,
      layout: {justify-content: .center, align-items: .center},
      fill: c.colors.light,
      corner-radius: 32px,
      padding: [0px, 14px],
      children: dayLabel,

      dayLabel = text {
        fill: c.colors.neutral-1,
        contents: "Sam 17",
        font-size: 13,
        font-family: f.fonts.ui,
        font-style: "Medium",
        line-height: 1
      }
    }
  }

  bandRemove = frame {
    width: l.lengths.tap,
    height: l.lengths.tap,
    layout: {justify-content: .center, align-items: .center},
    children: removeFace,

    removeFace = frame {
      width: 28px,
      height: 28px,
      layout: {justify-content: .center, align-items: .center},
      fill: c.colors.surface-dark,
      border: c.colors.border,
      corner-radius: 32px,
      children: removeGlyph,

      removeGlyph = asset {
        width: 16px,
        height: 16px,
        fill: c.colors.text-on-dark,
        contents: crossIcon
      }
    }
  }
}

// Champ d'ajout d'un groupe : le libellé à gauche, le « + » au bout à droite (ArtistField).
export artistAddField = frame {
  left: 2400px,
  top: 1200px,
  width: 100%,
  height: 48px,
  layout: {align-items: .center},
  fill: c.colors.surface-dark,
  border: c.colors.glass-border,
  corner-radius: l.lengths.radius-m,
  padding: [0px, 6px, 0px, 14px],
  children: [fieldValue, addArtist],

  fieldValue = text {
    width: 100%,
    fill: c.colors.text-on-dark-muted,
    contents: "Ajouter un groupe",
    font-size: 14,
    font-family: f.fonts.input,
    font-style: "Regular"
  }

  addArtist = frame {
    width: l.lengths.tap,
    height: l.lengths.tap,
    layout: {justify-content: .center, align-items: .center},
    children: addGlyph,

    addGlyph = asset {
      width: 20px,
      height: 20px,
      fill: c.colors.text-on-dark,
      contents: plusIcon
    }
  }
}

// Stepper des formulaires d'ajout : « Étape 2/3 », barre de progression claire (pas de lime : il est réservé aux CTA),
// puis la question de l'étape et une phrase d'aide. La largeur de `stepFill` se règle par écran (33 %, 66 %, 100 %…).
export stepHeader = frame {
  left: 1800px,
  top: 1450px,
  width: 100%,
  height: .auto,
  layout: {direction: .column, item-gap: 12px},
  padding: [0px, 8px],
  children: [stepLabel, stepTrack, stepTitle, stepHelp],

  stepLabel = text {
    width: 100%,
    fill: c.colors.text-on-dark-muted,
    contents: "Étape 1/3",
    font-size: 14,
    font-family: f.fonts.ui,
    font-style: "Medium"
  }

  stepTrack = frame {
    width: 100%,
    height: 4px,
    fill: c.colors.glass-strong,
    corner-radius: l.lengths.radius-pill,
    children: stepFill,

    stepFill = frame {
      left: 0px,
      top: 0px,
      width: 33%,
      height: 4px,
      fill: c.colors.light,
      corner-radius: l.lengths.radius-pill
    }
  }

  stepTitle = text {
    width: 100%,
    fill: c.colors.text-on-dark,
    contents: "Question de l'étape",
    font-size: 30,
    font-family: f.fonts.ui,
    font-style: "Medium",
    line-height: 1.05,
    letter-spacing: -3%
  }

  stepHelp = text {
    width: 100%,
    fill: c.colors.text-on-dark-muted,
    contents: "Phrase d'aide",
    font-size: 15,
    font-family: f.fonts.ui,
    font-style: "Regular",
    line-height: 1.3
  }
}

// Pied de page du stepper : « Retour » (verre) + « Suivant » (lime). Sur la 1re étape, `back` est masqué.
export stepActions = frame {
  left: 1200px,
  top: 1450px,
  width: 100%,
  height: .auto,
  layout: {item-gap: 12px},
  padding: [0px, 8px],
  children: [back, next],

  back = frame : secondaryButton {
    width: 120px,

    buttonGlyph {
      display: .none
    }

    buttonLabel {
      contents: "Retour"
    }
  }

  next = frame : primaryButton {
    buttonGlyph {
      display: .none
    }

    buttonLabel {
      contents: "Suivant"
    }
  }
}

// Champ en erreur : même champ, filet rouge. Le message se pose juste dessous (voir `fieldMessage`) et dit comment corriger.
@variant
export fieldError = frame : field {
  left: 1200px,
  top: 400px,

  fieldBox {
    border[0].color: c.colors.danger-text
  }
}

// Message d'erreur sous un champ : icône + texte, jamais la couleur seule.
export fieldMessage = frame {
  left: 1800px,
  top: 400px,
  width: 100%,
  height: .auto,
  layout: {align-items: .center, item-gap: 6px},
  children: [messageGlyph, messageText],

  messageGlyph = asset {
    width: 16px,
    height: 16px,
    fill: c.colors.danger-text,
    contents: crossIcon
  }

  messageText = text {
    width: 100%,
    fill: c.colors.danger-text,
    contents: "Message d'erreur",
    font-size: 13,
    font-family: f.fonts.ui,
    font-style: "Regular",
    line-height: 1.3
  }
}

// Jour du calendrier flottant : zone tactile 44 px, rayon 10, chiffre Medium 16. Base = jour libre.
