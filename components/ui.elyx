}

// Jour choisi (début ou fin de la plage) : pilule claire, chiffre noir
@variant
export calendarDayOn = frame : calendarDay {
  left: 2400px,
  top: 100px,
  fill[0].color: c.colors.light,

  dayLabel {
    fill[0].color: c.colors.neutral-1
  }
}

// Jour compris dans la plage : fond de survol, chiffre clair
@variant
export calendarDayIn = frame : calendarDay {
  left: 2400px,
  top: 200px,
  fill[0].color: c.colors.state-hover
}

// Aujourd'hui : anneau de 2 px (jamais la couleur seule)
@variant
export calendarDayToday = frame : calendarDay {
  left: 2400px,
  top: 300px,
  border[0].color: c.colors.text-on-dark,
  border[0].width: 2px
}

// Calendrier en fenêtre centrée : posé au milieu de l'écran sur un voile noir, quel que soit le champ touché (« Dates » ou « Date »).
// Le titre et la plage choisie restent visibles en haut. Premier toucher = début, second = fin, puis « Valider » ferme la fenêtre.
// Toucher le voile ou Échap la ferme sans rien changer.
export calendarDialog = frame {
  left: 2400px,
  top: 500px,
