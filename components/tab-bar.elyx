use "fonts/Archivo.ttf"

import "icons/lucide/house.svg" as houseIcon
import "icons/lucide/history.svg" as historyIcon
import "icons/lucide/plus.svg" as plusIcon
import "tokens/colors.elyx" as c
import "tokens/lengths.elyx" as l
import "tokens/fonts.elyx" as f

// Barre d'onglets flottante : une pilule ronde détachée du bord, icônes seules (l'onglet actif est un disque encre plein).
// Le bouton « + » revient en bas à droite, sur la même ligne.
export tabBar = frame {
  left: 0px,
  top: 0px,
  width: .auto,
  height: 64px,
  layout: {align-items: .center, item-gap: 8px},
  fill: c.colors.surface-card,
  corner-radius: 32px,
  padding: 8px,
  children: [tabHome, tabHistory],

  tabHome = frame {
    width: 48px,
    height: 48px,
    layout: {justify-content: .center, align-items: .center},
    fill: c.colors.action,
    corner-radius: 24px,
    children: homeGlyph,

    homeGlyph = asset {
      width: 24px,
      height: 24px,
      fill: c.colors.on-action,
      contents: houseIcon
    }
  }

  tabHistory = frame {
    width: 48px,
    height: 48px,
    layout: {justify-content: .center, align-items: .center},
    corner-radius: 24px,
    children: historyGlyph,

    historyGlyph = asset {
      width: 24px,
      height: 24px,
      fill: c.colors.ink,
      contents: historyIcon
    }
  }
}

// Bouton « + » rond, en bas à droite, à portée du pouce. Action principale : encre pleine.
export addButton = frame {
  left: 0px,
  top: 100px,
  width: 64px,
  height: 64px,
  layout: {justify-content: .center, align-items: .center},
  fill: c.colors.action,
  corner-radius: 32px,
  children: addGlyph,

  addGlyph = asset {
    width: 30px,
    height: 30px,
    fill: c.colors.on-action,
    contents: plusIcon
  }
}
