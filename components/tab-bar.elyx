import "icons/lucide/house.svg" as houseIcon
import "icons/lucide/history.svg" as historyIcon
import "icons/lucide/plus.svg" as plusIcon
import "tokens/colors.elyx" as c
import "tokens/lengths.elyx" as l

// Onglet de la barre : disque de 48 px (zone tactile > 44 px), icône seule. Base = onglet inactif, icône blanche.
// États (théorie Radix) : survol = step 4, pressé = step 5, focus = anneau 2 px extérieur, désactivé = step 9 sur step 4.
export tabItem = frame {
  left: 0px,
  top: 200px,
  width: 48px,
  height: 48px,
  layout: {justify-content: .center, align-items: .center},
  corner-radius: 24px,
  children: glyph,

  glyph = asset {
    width: 24px,
    height: 24px,
    fill: c.colors.text-on-dark,
    contents: houseIcon
  }
}

// Onglet actif : disque gris clair, icône noire (le vert reste au billet et au « + »).
@variant
export tabItemActive = frame : tabItem {
  left: 200px,
  top: 0px,
  fill[0].color: c.colors.light,

  glyph {
    fill[0].color: c.colors.neutral-1
  }
}

@variant
export tabItemHover = frame : tabItem {
  left: 200px,
  top: 100px,
  fill[0].color: c.colors.state-hover
}

@variant
export tabItemPressed = frame : tabItem {
  left: 200px,
  top: 200px,
  fill[0].color: c.colors.state-pressed
}

@variant
export tabItemFocus = frame : tabItem {
  left: 200px,
  top: 300px,
  border[0].color: c.colors.focus-ring,
  border[0].position: .outside,
  border[0].width: l.lengths.focus-ring-width
}

@variant
export tabItemDisabled = frame : tabItem {
  left: 200px,
  top: 400px,
  fill[0].color: c.colors.disabled-bg,

  glyph {
    fill[0].color: c.colors.disabled-text
  }
}

// Barre d'onglets flottante : pilule en verre sombre détachée du bord. Accueil actif par défaut ;
// sur l'historique, basculer les deux onglets avec @with-variant.
export tabBar = frame {
  left: 0px,
  top: 0px,
  width: .auto,
  height: 64px,
  layout: {align-items: .center, item-gap: 8px},
  fill: c.colors.glass-strong,
  border: c.colors.glass-border,
  corner-radius: 32px,
  padding: 8px,
  children: [tabHome, tabHistory],

  tabHome = frame : tabItemActive {
    glyph {
      contents: houseIcon
    }
  }

  tabHistory = frame : tabItem {
    glyph {
      contents: historyIcon
    }
  }
}

// Bouton « + » rond, en bas à droite, à portée du pouce. Action principale (CTA) : vert, icône noire, sans libellé.
export addButton = frame {
  left: 0px,
  top: 100px,
  width: 64px,
  height: 64px,
  layout: {justify-content: .center, align-items: .center},
  fill: c.colors.cta,
  corner-radius: 32px,
  children: addGlyph,

  addGlyph = asset {
    width: 30px,
    height: 30px,
    fill: c.colors.on-cta,
    contents: plusIcon
  }
}

// États du bouton « + » : survol lime-10, pressé lime-11, focus anneau blanc, désactivé gris.
@variant
export addButtonHover = frame : addButton {
  left: 400px,
  top: 0px,
  fill[0].color: c.colors.cta-hover
}

@variant
export addButtonPressed = frame : addButton {
  left: 400px,
  top: 100px,
  fill[0].color: c.colors.cta-pressed
}

@variant
export addButtonFocus = frame : addButton {
  left: 400px,
  top: 200px,
  border[0].color: c.colors.focus-ring,
  border[0].position: .outside,
  border[0].width: l.lengths.focus-ring-width
}

@variant
export addButtonDisabled = frame : addButton {
  left: 400px,
  top: 300px,
  fill[0].color: c.colors.disabled-bg,

  addGlyph {
    fill[0].color: c.colors.disabled-text
  }
}
