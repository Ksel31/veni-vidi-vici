use "fonts/CabinetGrotesk-Variable.ttf"

import "images/bg-add-festival.jpg" as bgPhoto
import "components/screen-header.elyx" as headers
import "components/ui.elyx" as ui
import "icons/lucide/calendar.svg" as calendarIcon
import "icons/lucide/tent.svg" as tentIcon
import "icons/lucide/map-pin.svg" as mapPinIcon
import "icons/lucide/building-2.svg" as buildingIcon
import "screens/add-festival-2.elyx" as step2

// Ajout d'un festival, étape 1/3 : le titre et les dates, les deux seules infos obligatoires.
export addFestival = frame {
  title: "Ajouter un festival, étape 1/3",
  caption: "Un festival se saisit en 3 étapes : titre, dates et lieu, line-up, billet. Un seul calendrier (premier toucher = début, second = fin).",
  left: 0px,
  top: 0px,
  width: 390px,
  height: 844px,
  layout: {direction: .column, justify-content: .space-between},
  fill: [
    {image: {ref: bgPhoto}},
    {
      linear-gradient: {
        angle: 180deg,
        stops: [
          stop(0%, rgb(0%, 0%, 0%, 60%)),
          stop(40%, rgb(0%, 0%, 0%, 72%)),
          stop(100%, rgb(0%, 0%, 0%, 92%))
        ]
      }
    }
  ],
  corner-radius: 48px,
  padding: [24px, 12px, 32px],
  children: [top, actions],

  top = frame {
    width: 100%,
    height: .auto,
    layout: {direction: .column, item-gap: 20px},
    children: [header, intro, card],

    header = frame : headers.pageHeader {
      padding-top: 8px,
      padding-left: 8px,
      padding-bottom: 0px,
      padding-right: 8px,

      pageTitle {
        contents: "Nouveau festival"
      }
    }

    intro = frame : ui.stepHeader {
      stepTrack {
        stepFill {
          width: 117px
        }
      }

      stepLabel {
        contents: "Étape 1/3"
      }

      stepTitle {
        contents: "Quel festival ?"
      }

      stepHelp {
        contents: "Le titre et les dates sont obligatoires ; le lieu peut venir plus tard."
      }
    }

    card = frame : ui.glassCard {
      overrides: [
        insert(titleField, after = ui.glassCard.cardTitle),
        insert(dates, after = titleField),
        insert(cityField, after = dates),
        insert(roomField, after = cityField)
      ],

      cardTitle {
        display: .none
      }

      titleField = frame : ui.field {
        fieldBox {
          fieldGlyph {
            contents: tentIcon
          }

          fieldValue {
            contents: "Rock Werchter"
          }
        }

        fieldLabel {
          contents: "Titre *"
        }
      }

      dates = frame : ui.field {
        fieldBox {
          fieldGlyph {
            contents: calendarIcon
          }

          fieldValue {
            contents: "17 – 20 juil. 2026"
          }
        }

        fieldLabel {
          contents: "Dates *"
        }
      }

      cityField = frame : ui.field {
        fieldBox {
          fieldGlyph {
            contents: mapPinIcon
          }

          fieldValue {
            contents: "Werchter"
          }
        }

        fieldLabel {
          contents: "Ville"
        }
      }

      roomField = frame : ui.field {
        fieldBox {
          fieldGlyph {
            contents: buildingIcon
          }

          fieldValue {
            contents: "Rock Werchter"
          }
        }

        fieldLabel {
          contents: "Lieu, salle"
        }
      }
    }
  }

  actions = frame : ui.stepActions {
    next {
      connections[0].target: step2.addFestival2,
      connections[0].label: "Suivant"
    }

    back {
      display: .none
    }
  }
}
