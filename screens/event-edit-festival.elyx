use "fonts/CabinetGrotesk-Variable.ttf"

import "images/bg-event-edit.jpg" as bgPhoto
import "components/screen-header.elyx" as headers
import "tokens/colors.elyx" as c
import "components/ui.elyx" as ui
import "icons/lucide/check.svg" as checkIcon
import "icons/lucide/plus.svg" as plusIcon
import "icons/lucide/calendar.svg" as calendarIcon
import "icons/lucide/map-pin.svg" as mapPinIcon
import "icons/lucide/euro.svg" as euroIcon
import "icons/lucide/tent.svg" as tentIcon

// Modifier un festival : même formulaire que l'ajout, pré-rempli. Pas de rôles tête d'affiche / première partie :
// chaque groupe a le jour de son passage. « Supprimer l'event » est un bouton secondaire, sans poubelle.
export eventEditFestival = frame {
  title: "Modifier un festival",
  caption: "Même route que le concert, autre formulaire. Ville puis salle, un seul calendrier, groupes avec leur jour au-dessus du champ d'ajout.",
  left: 0px,
  top: 0px,
  width: 390px,
  height: .auto,
  layout: {direction: .column},
  fill: [
    {image: {ref: bgPhoto}},
    {
      linear-gradient: {
        angle: 180deg,
        stops: [
          stop(0%, rgb(0%, 0%, 0%, 62%)),
          stop(40%, rgb(0%, 0%, 0%, 74%)),
          stop(100%, rgb(0%, 0%, 0%, 92%))
        ]
      }
    }
  ],
  corner-radius: 48px,
  padding: [24px, 12px, 40px],
  children: [header, body],

  header = frame : headers.pageHeader {
    padding-top: 8px,
    padding-left: 8px,
    padding-bottom: 0px,
    padding-right: 8px,

    pageTitle {
      contents: "Modifier l'event"
    }
  }

  body = frame {
    width: 100%,
    height: .auto,
    layout: {direction: .column, item-gap: 14px},
    padding: [20px, 8px, 0px],
    children: [required, whenWhere, lineup, ticket, note, submit, remove],

    required = text : ui.hint {
      contents: "* Obligatoire"
    }

    whenWhere = frame : ui.glassCard {
      overrides: [
        insert(titleField, after = ui.glassCard.cardTitle),
        insert(dates, after = titleField),
        insert(cityField, after = dates),
        insert(roomField, after = cityField)
      ],

      cardTitle {
        contents: "Le festival"
      }

      titleField = frame : ui.field {
        fieldBox {
          fieldGlyph {
            contents: tentIcon
          }

          fieldValue {
            contents: "Desertfest Belgium"
          }
        }

        fieldLabel {
          contents: "Titre *"
        }
      }

      dates = frame : ui.field {
        fieldBox {
          fieldGlyph {
            contents: calendarIcon
          }

          fieldValue {
            contents: "17 – 18 oct. 2026"
          }
        }

        fieldLabel {
          contents: "Dates *"
        }
      }

      cityField = frame : ui.field {
        fieldBox {
          fieldGlyph {
            contents: mapPinIcon
          }

          fieldValue {
            contents: "Anvers"
          }
        }

        fieldLabel {
          contents: "Ville"
        }
      }

      roomField = frame : ui.fieldEmpty {
        fieldBox {
          fieldGlyph {
            contents: mapPinIcon
          }

          fieldValue {
            contents: ""
          }
        }

        fieldLabel {
          contents: "Lieu, salle"
        }
      }
    }

    lineup = frame : ui.glassCard {
      overrides: [
        insert(band1, after = ui.glassCard.cardTitle),
        insert(band2, after = band1),
        insert(band3, after = band2),
        insert(addBand, after = band3)
      ],

      cardTitle {
        contents: "Line-up à voir"
      }

      band1 = frame : ui.festivalBand {
        bandName {
          contents: "Truckfighters"
        }
      }

      band2 = frame : ui.festivalBand {
        bandName {
          contents: "Nebula"
        }
      }

      band3 = frame : ui.festivalBand {
        bandName {
          contents: "Elder"
        }
      }

      addBand = frame : ui.artistAddField {
        fieldValue {
          contents: "Ajouter un groupe et son jour"
        }
      }
    }

    ticket = frame : ui.glassCard {
      overrides: [
        insert(ticketBought, after = ui.glassCard.cardTitle),
        insert(ticketPrice, after = ticketBought),
        insert(ticketUpload, after = ticketPrice)
      ],

      cardTitle {
        contents: "Billet"
      }

      ticketBought = frame : ui.checkRowOff {
        checkTexts {
          checkTitle {
            contents: "Billet acheté"
          }

          checkMeta {
            contents: "Coche quand tu l'as en poche."
          }
        }
      }

      ticketPrice = frame : ui.fieldEmpty {
        fieldBox {
          fieldGlyph {
            contents: euroIcon
          }

          fieldValue {
            contents: "65,00"
          }
        }

        fieldLabel {
          contents: "Prix du billet"
        }
      }

      ticketUpload = frame : ui.uploadBox {}
    }

    note = text : ui.hint {
      contents: "Si la date repasse à aujourd'hui ou plus tard, l'event redevient prévu."
    }

    submit = frame : ui.primaryButton {
      buttonGlyph {
        contents: checkIcon
      }

      buttonLabel {
        contents: "Enregistrer"
      }
    }

    remove = frame : ui.secondaryButton {
      buttonGlyph {
        display: .none
      }

      buttonLabel {
        contents: "Supprimer l'event"
      }
    }
  }
}
