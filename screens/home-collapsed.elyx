import "./home.elyx" as homeScreen
import "icons/lucide/chevron-right.svg" as arrowRight

// Même accueil avec « À venir » et « Historique » repliés : seuls les en-têtes restent.
homeCollapsed = frame : homeScreen.home {
  title: "Accueil, groupes repliés",
  caption: "Un groupe replié ne garde que son titre, son nombre d'events et le bouton avec une flèche vers la droite.",
  left: 540px,

  content {
    upcomingSection {
      upcomingDivider1 {
        display: .none
      }

      row1 {
        display: .none
      }

      upcomingDivider2 {
        display: .none
      }

      row2 {
        display: .none
      }

      upcomingDivider3 {
        display: .none
      }

      upcomingMore {
        display: .none
      }

      upcomingHeader {
        headerToggle {
          toggleIcon {
            contents: arrowRight
          }
        }
      }
    }

    historySection {
      historyDivider1 {
        display: .none
      }

      historyRow1 {
        display: .none
      }

      historyDivider2 {
        display: .none
      }

      historyRow2 {
        display: .none
      }

      historyDivider3 {
        display: .none
      }

      historyMore {
        display: .none
      }

      historyHeader {
        headerToggle {
          toggleIcon {
            contents: arrowRight
          }
        }
      }
    }
  }
}
