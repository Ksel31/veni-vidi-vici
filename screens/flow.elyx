import "screens/login.elyx" as login
import "screens/home.elyx" as home
import "screens/event-upcoming.elyx" as eventUpcoming
import "screens/event-edit.elyx" as eventEdit
import "screens/to-confirm.elyx" as toConfirm
import "screens/event-confirm.elyx" as eventConfirm
import "screens/event-report.elyx" as eventReport
import "screens/event-festival.elyx" as eventFestival
import "screens/event-edit-festival.elyx" as eventEditFestival
import "screens/history.elyx" as history
import "screens/add-type.elyx" as addType
import "screens/add-concert.elyx" as addConcert
import "screens/add-concert-2.elyx" as addConcert2
import "screens/add-concert-3.elyx" as addConcert3
import "screens/add-exit.elyx" as addExit
import "screens/add-festival.elyx" as addFestival
import "screens/add-festival-2.elyx" as addFestival2
import "screens/add-festival-3.elyx" as addFestival3
import "screens/add-festival-error.elyx" as addFestivalError
import "screens/profile.elyx" as profileScreen
import "screens/onboarding-1.elyx" as onboarding1
import "screens/home-empty.elyx" as homeEmpty
import "screens/profile-empty.elyx" as profileEmpty
import "screens/onboarding-2.elyx" as onboarding2
import "screens/onboarding-3.elyx" as onboarding3
import "screens/add-concert-calendar.elyx" as addConcertCalendar
import "screens/add-festival-calendar.elyx" as addFestivalCalendar
import "screens/home-first-event.elyx" as homeFirstEvent
import "screens/signup.elyx" as signup
import "screens/signup-error.elyx" as signupError

file {
  draw-connections: .true
}

// Parcours complet de l'app : connexion, accueil, puis trois branches (à confirmer, historique, ajout) qui convergent
// vers la fiche de l'event. Colonnes = étapes, lignes = branches. Chaque flèche vient d'un `connections` posé sur le bouton.
flowLogin = frame : login.login {
  left: -1295px,
  top: 435px
}

flowHome = frame : home.home {
  left: -1100px,
  top: 2204px,
  overrides: [
    remove(home.home.addButton),
    remove(home.home.tabs),
    remove(home.home.bottomFade),
    remove(home.home.upcoming)
  ],

  nextBlock {
    ticket {
      connections[0].label-position: 0.428,
      connections[0].route: [
        {x: -1641px, near: -1046px},
        {y: -1103px, near: 291px}
      ]
    }
  }
}

flowToConfirm = frame : toConfirm.toConfirm {
  left: -400px,
  top: 2204px
}

flowHistory = frame : history.history {
  left: -1100px,
  top: 3404px
}

flowAddType = frame : addType.addType {
  left: -1100px,
  top: 4704px
}

flowEventConfirm = frame : eventConfirm.eventConfirm {
  left: 300px,
  top: 2204px,
  overrides: [
    remove(eventConfirm.eventConfirm.body),
    remove(eventConfirm.eventConfirm.header)
  ]
}

flowEventFestival = frame : eventFestival.eventFestival {
  left: 300px,
  top: 3404px
}

flowAddConcert = frame : addConcert.addConcert {
  left: -400px,
  top: 4704px,

  top {
    card {
      dateField {
        connections[0].target: flowAddConcertCalendar,
        connections[0].label: "Toucher « Date »",
        connections[0].route: [{x: -166px, near: 117px}]
      }
    }
  }
}

flowAddConcertCalendar = frame : addConcertCalendar.addConcertCalendar {
  left: -400px,
  top: 5804px,
  overrides: [remove(addConcertCalendar.addConcertCalendar.scrim)]
}

flowAddConcert2 = frame : addConcert2.addConcert2 {
  left: 300px,
  top: 4704px
}

flowAddConcert3 = frame : addConcert3.addConcert3 {
  left: 1000px,
  top: 4704px,

  actions {
    next {
      connections[2].target: homeFirstEvent.homeFirstEvent,
      connections[2].label: "1er event (onboarding)"
    }
  }
}

flowAddFestival = frame : addFestival.addFestival {
  left: -369px,
  top: 6783px,

  top {
    card {
      dates {
        connections[0].target: flowAddFestivalCalendar,
        connections[0].label: "Toucher « Dates »",
        connections[0].label-position: 0.44
      }
    }
  }
}

flowAddFestivalCalendar = frame : addFestivalCalendar.addFestivalCalendar {
  left: -1100px,
  top: 6904px
}

flowAddFestival2 = frame : addFestival2.addFestival2 {
  left: 300px,
  top: 6904px
}

flowAddFestival3 = frame : addFestival3.addFestival3 {
  left: 1000px,
  top: 6904px,

  actions {
    next {
      connections[1].target: homeFirstEvent.homeFirstEvent,
      connections[1].label: "1er event (onboarding)",
      connections[0].label-position: 0.18,
      connections[0].route: [{y: 900px, near: 106px}]
    }
  }
}

flowEventReport = frame : eventReport.eventReport {
  left: 1000px,
  top: 2204px,
  overrides: [remove(eventReport.eventReport.body)]
}

flowEventUpcoming = frame : eventUpcoming.eventUpcoming {
  left: 3500px,
  top: 4300px
}

flowEventEdit = frame : eventEdit.eventEdit {
  left: 3500px,
  top: 0px
}

flowEventEditFestival = frame : eventEditFestival.eventEditFestival {
  left: 4200px,
  top: 1700px
}

// Compte vide (rangée au-dessus de la connexion) : onboarding en trois écrans à swiper, puis l'accueil vide.
// « Passer » saute directement à l'accueil vide ; « Ajouter mon 1er event » ouvre l'ajout.
flowOnboarding1 = frame : onboarding1.onboarding1 {
  left: 0px,
  top: 0px,

  arrow {
    connections[0].label-position: 0.506,
    connections[0].route: [{y: 2px, near: -102px}]
  }

  top {
    skip {
      connections[0].label-position: 0.478,
      connections[0].route: [
        {y: -438px, near: -723px},
        {x: -26px, near: 107px},
        {y: -446px, near: 71px}
      ]
    }
  }
}

flowOnboarding2 = frame : onboarding2.onboarding2 {
  left: 700px,
  top: 0px,

  arrow {
    connections[0].route: [{y: -3px, near: 23px}]
  }

  top {
    skip {
      connections[0].route: [{y: -341px, near: -434px}]
    }
  }
}

flowOnboarding3 = frame : onboarding3.onboarding3 {
  left: 1400px,
  top: 0px,

  lower {
    choices {
      concertChoice {
        connections[0].label-position: 0.357,
        connections[0].route: [
          {x: 1223px, near: -1396px},
          {y: -1344px, near: -37px}
        ]
      }
    }
  }
}

flowHomeEmpty = frame : homeEmpty.homeEmpty {
  left: 2100px,
  top: 0px
}

// Fin de l'onboarding : une fois le 1er event ajouté (concert ou festival à venir), retour direct à l'accueil avec le toast « Event ajouté ».
flowHomeFirstEvent = frame : homeFirstEvent.homeFirstEvent {
  left: 2800px,
  top: 0px,

  profile {
    identity {
      who {
        avatar {
          connections[0].route: [{y: -1889px, near: 2058px}]
        }
      }
    }
  }
}

// Confirmation « Quitter l'ajout ? » (depuis la croix de l'étape 2 du concert) et état d'erreur du festival (titre manquant).
flowAddExit = frame : addExit.addExit {
  left: 300px,
  top: 5804px,

  panel {
    dialogActions {
      cancel {
        connections[0].route: [
          {y: 1926px, near: 568px},
          {x: 571px, near: 1194px},
          {y: 1928px, near: 705px},
          {x: 301px, near: 1970px},
          {y: 2018px, near: 272px},
          {y: 2022px, near: 173px}
        ]
      }
    }
  }
}

flowAddFestivalError = frame : addFestivalError.addFestivalError {
  left: -400px,
  top: 8104px,
  overrides: [remove(addFestivalError.addFestivalError.top)]
}

// Inscription (depuis « Créer un compte » de la connexion) et profil (depuis l'avatar de l'accueil).
// Retour : flèche vers l'accueil ; « Se déconnecter » ramène à la connexion.
flowSignup = frame : signup.signup {
  left: -1800px,
  top: 971px,

  form {
    submit {
      connections[0].target: onboarding1.onboarding1,
      connections[0].label: "Créer mon compte",
      connections[0].label-position: 0.418,
      connections[0].route: [{x: -52px, near: -140px}]
    }
  }

  top {
    backButton {
      connections[0].target: login.login,
      connections[0].label: "Retour"
    }
  }
}

flowProfile = frame : profileScreen.profile {
  left: -1900px,
  top: 2204px,

  top {
    backButton {
      connections[0].target: home.home,
      connections[0].label: "Retour"
    }
  }

  logout {
    connections[0].target: login.login,
    connections[0].label: "Se déconnecter"
  }
}

flowProfileEmpty = frame : profileEmpty.profileEmpty {
  left: -1900px,
  top: 3404px
}

// Erreurs de saisie de l'inscription (nom déjà pris, mots de passe différents).
flowSignupError = frame : signupError.signupError {
  left: -2500px,
  top: 971px
}
