import "screens/redone/login.elyx" as login
import "screens/redone/home.elyx" as home
import "screens/redone/event-upcoming.elyx" as eventUpcoming
import "screens/redone/event-edit.elyx" as eventEdit
import "screens/redone/to-confirm.elyx" as toConfirm
import "screens/redone/event-confirm.elyx" as eventConfirm
import "screens/redone/event-report.elyx" as eventReport
import "screens/redone/event-festival.elyx" as eventFestival
import "screens/redone/event-edit-festival.elyx" as eventEditFestival
import "screens/redone/history.elyx" as history
import "screens/redone/add-type.elyx" as addType
import "screens/redone/add-concert.elyx" as addConcert
import "screens/redone/add-concert-2.elyx" as addConcert2
import "screens/redone/add-concert-3.elyx" as addConcert3
import "screens/redone/add-exit.elyx" as addExit
import "screens/redone/add-festival.elyx" as addFestival
import "screens/redone/add-festival-2.elyx" as addFestival2
import "screens/redone/add-festival-3.elyx" as addFestival3
import "screens/redone/add-festival-error.elyx" as addFestivalError
import "screens/redone/onboarding-1.elyx" as onboarding1
import "screens/redone/home-empty.elyx" as homeEmpty
import "screens/redone/onboarding-2.elyx" as onboarding2
import "screens/redone/onboarding-3.elyx" as onboarding3

file {
  draw-connections: .true
}

// Parcours complet de l'app : connexion, accueil, puis trois branches (à confirmer, historique, ajout) qui convergent
// vers la fiche de l'event. Colonnes = étapes, lignes = branches. Chaque flèche vient d'un `connections` posé sur le bouton.
flowLogin = frame : login.login {
  left: 0px,
  top: 0px
}

flowHome = frame : home.home {
  left: 700px,
  top: 0px
}

flowToConfirm = frame : toConfirm.toConfirm {
  left: 1400px,
  top: 0px
}

flowHistory = frame : history.history {
  left: 1400px,
  top: 1100px
}

flowAddType = frame : addType.addType {
  left: 1072px,
  top: 2519px
}

flowEventConfirm = frame : eventConfirm.eventConfirm {
  left: 2518px,
  top: -45px,
  overrides: [remove(eventConfirm.eventConfirm.header)]
}

flowEventFestival = frame : eventFestival.eventFestival {
  left: 2100px,
  top: 1100px
}

flowAddConcert = frame : addConcert.addConcert {
  left: 1700px,
  top: 2260px
}

flowAddConcert2 = frame : addConcert2.addConcert2 {
  left: 2220px,
  top: 2260px
}

flowAddConcert3 = frame : addConcert3.addConcert3 {
  left: 2740px,
  top: 2260px
}

flowAddFestival = frame : addFestival.addFestival {
  left: 1072px,
  top: 5300px
}

flowAddFestival2 = frame : addFestival2.addFestival2 {
  left: 1592px,
  top: 5300px
}

flowAddFestival3 = frame : addFestival3.addFestival3 {
  left: 2112px,
  top: 5300px
}

flowEventReport = frame : eventReport.eventReport {
  left: 3771px,
  top: -535px
}

flowEventUpcoming = frame : eventUpcoming.eventUpcoming {
  left: 2852px,
  top: 3966px
}

flowEventEdit = frame : eventEdit.eventEdit {
  left: 3701px,
  top: 2624px
}

flowEventEditFestival = frame : eventEditFestival.eventEditFestival {
  left: 5022px,
  top: 1243px
}

// Compte vide (rangée au-dessus de la connexion) : onboarding en trois écrans à swiper, puis l'accueil vide.
// « Passer » saute directement à l'accueil vide ; « Ajouter mon 1er event » ouvre l'ajout.
flowOnboarding1 = frame : onboarding1.onboarding1 {
  left: 0px,
  top: -1100px
}

flowOnboarding2 = frame : onboarding2.onboarding2 {
  left: 700px,
  top: -1100px
}

flowOnboarding3 = frame : onboarding3.onboarding3 {
  left: 1400px,
  top: -1100px
}

flowHomeEmpty = frame : homeEmpty.homeEmpty {
  left: 2100px,
  top: -1100px
}

// Confirmation « Quitter l'ajout ? » (depuis la croix de l'étape 2 du concert) et état d'erreur du festival (titre manquant).
flowAddExit = frame : addExit.addExit {
  left: 2220px,
  top: 3600px
}

flowAddFestivalError = frame : addFestivalError.addFestivalError {
  left: 1072px,
  top: 6500px
}
