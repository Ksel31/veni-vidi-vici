use "fonts/CabinetGrotesk-Variable.ttf"

import "images/bg-history.jpg" as bgPhoto
import "components/ui.elyx" as ui
import "icons/lucide/x.svg" as crossIcon
import "tokens/colors.elyx" as c
import "tokens/fonts.elyx" as f
import "components/tab-bar.elyx" as nav
import "screens/event-report.elyx" as eventReport

// Historique : events vus et ratés, du plus récent au plus ancien, filtrés par année. Onglet « historique » actif.
export history = frame {
  title: "Historique",
  caption: "Vidi : tout ce qui est passé. Filtre par année ; un event vu mène à son compte rendu. La croix olive (neutral-11, trait 2) en haut à droite supprime ; la pastille Vu ou Raté ne bouge pas. La confirmation est le panneau opaque ui.deleteConfirm, sur un voile noir à 60 %.",
  left: 0px,
  top: 0px,
  width: 390px,
  height: 844px,
  layout: {direction: .column},
  fill: [
    {image: {ref: bgPhoto}},
    {
      linear-gradient: {
        angle: 180deg,
        stops: [
          stop(0%, rgb(0%, 0%, 0%, 55%)),
          stop(40%, rgb(0%, 0%, 0%, 68%)),
          stop(100%, rgb(0%, 0%, 0%, 92%))
        ]
      }
    }
  ],
  corner-radius: 48px,
  padding: [24px, 12px, 0px],
  children: [top, list, bottomFade, tabs, addButton],

  top = frame {
    width: 100%,
    height: .auto,
    layout: {direction: .column, item-gap: 18px},
    padding: [32px, 6px, 0px],
    children: [pageTitle, years],

    pageTitle = text {
      width: 100%,
      fill: c.colors.text-on-dark,
      contents: "Historique",
      font-size: 36,
      font-family: f.fonts.ui,
      line-height: 1,
      letter-spacing: -3%
    }

    years = frame {
      width: 100%,
      height: .auto,
      layout: {item-gap: 8px},
      children: [year2026, year2025, year2024],

      year2026 = frame : ui.chipOn {
        chipLabel {
          contents: "2026"
        }
      }

      year2025 = frame : ui.chip {
        chipLabel {
          contents: "2025"
        }
      }

      year2024 = frame : ui.chip {
        chipLabel {
          contents: "2024"
        }
      }
    }
  }

  list = frame {
    width: 100%,
    height: .auto,
    layout: {direction: .column, item-gap: 12px},
    padding: [20px, 0px, 0px],
    children: [dour, alcest, messa],

    dour = frame : ui.pastRow {
      padding: [22px, 16px, 12px, 12px],

      deleteMark {
        display: .visible
      }

      info {
        eventTitle {
          contents: "Dour Festival"
        }

        eventMeta {
          contents: "Festival, 4 jours, Dour"
        }
      }

      dateBlock {
        dateDay {
          contents: "16"
        }

        dateMonth {
          contents: "JUIL"
        }
      }
    }

    alcest = frame : ui.pastRow {
      padding: [22px, 16px, 12px, 12px],

      deleteMark {
        display: .visible
      }

      status {
        fill[0].color: c.colors.danger-bg,
        border[0].color: c.colors.danger-border,

        badgeGlyph {
          fill[0].color: c.colors.danger-text,
          contents: crossIcon
        }

        badgeLabel {
          fill[0].color: c.colors.danger-text,
          contents: "Raté"
        }
      }

      info {
        eventTitle {
          contents: "Alcest"
        }

        eventMeta {
          contents: "Botanique, Bruxelles"
        }
      }

      dateBlock {
        dateDay {
          contents: "02"
        }

        dateMonth {
          contents: "MAI"
        }
      }
    }

    messa = frame : ui.pastRow {
      padding: [22px, 16px, 12px, 12px],

      deleteMark {
        display: .visible
      }

      connections[0].label: "Compte rendu",
      connections[0].target: eventReport.eventReport,

      info {
        eventMeta {
          contents: "Trix, Anvers"
        }

        eventTitle {
          contents: "Messa"
        }
      }

      dateBlock {
        dateMonth {
          contents: "MARS"
        }

        dateDay {
          contents: "19"
        }
      }
    }
  }

  // Fondu noir sous la barre d'onglets, comme sur l'accueil
  bottomFade = frame {
    left: 0px,
    bottom: 0px,
    width: 100%,
    height: 190px,
    ignore-stack: .true,
    fill: {
      linear-gradient: {
        angle: 180deg,
        stops: [
          stop(0%, rgb(6.7%, 6.7%, 6.7%, 0%)),
          stop(70%, rgb(6.7%, 6.7%, 6.7%, 92%))
        ]
      }
    }
  }

  tabs = frame : nav.tabBar {
    left: 20px,
    bottom: 32px,
    ignore-stack: .true,

    tabHistory {
      fill[0].color: c.colors.light,

      glyph {
        fill[0].color: c.colors.neutral-1
      }
    }

    tabHome {
      fill[0].color: .transparent,

      glyph {
        fill[0].color: c.colors.text-on-dark
      }
    }
  }

  addButton = frame : nav.addButton {
    right: 20px,
    bottom: 32px,
    ignore-stack: .true
  }
}
