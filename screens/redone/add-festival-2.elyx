use "fonts/CabinetGrotesk-Variable.ttf"

import "images/bg-add-festival.jpg" as bgPhoto
import "components/redone/screen-header.elyx" as headers
import "components/redone/ui.elyx" as ui
import "icons/lucide/x.svg" as closeIcon
import "screens/redone/add-festival-3.elyx" as step3

// Ajout d'un festival, étape 2/3 : le line-up « à voir », un jour par groupe. Ici des groupes sont déjà ajoutés : « Suivant ».
export addFestival2 = frame {
  title: "Ajouter un festival, étape 2/3",
  caption: "Refonte : même logique que les concerts (croix, dégradé dense, hauteur minimale). Avec des groupes ajoutés le bouton dit « Suivant » ; sans groupe il dirait « Passer ».",
  left: 0px,
  top: 0px,
  width: 390px,
  height: .auto,
  min-height: 844px,
  layout: {direction: .column, justify-content: .space-between},
  fill: [
    {image: {ref: bgPhoto}},
    {
      linear-gradient: {
        angle: 180deg,
        stops: [
          stop(0%, rgb(0%, 0%, 0%, 78%)),
          stop(40%, rgb(0%, 0%, 0%, 80%)),
          stop(100%, rgb(0%, 0%, 0%, 92%))
        ]
      }
    }
  ],
  corner-radius: 48px,
  padding: [24px, 12px, 32px],
  children: [top, actions],

  top = frame {
    width: 100%,
    height: .auto,
    layout: {direction: .column, item-gap: 20px},
    children: [header, intro, card],

    header = frame : headers.pageHeader {
      padding-top: 8px,
      padding-left: 8px,
      padding-bottom: 0px,
      padding-right: 8px,

      backButton {
        glyph {
          contents: closeIcon
        }
      }

      pageTitle {
        contents: "Nouveau festival"
      }
    }

    intro = frame : ui.stepHeader {
      stepLabel {
        contents: "Étape 2/3"
      }

      stepTrack {
        stepFill {
          width: 233px
        }
      }

      stepTitle {
        contents: "Quels groupes ?"
      }

      stepHelp {
        contents: "Ajoute les groupes que tu veux voir, avec leur jour."
      }
    }

    card = frame : ui.glassCard {
      overrides: [
        insert(band1, after = ui.glassCard.cardTitle),
        insert(band2, after = band1),
        insert(band3, after = band2),
        insert(band4, after = band3),
        insert(addBand, after = band4)
      ],

      cardTitle {
        display: .none
      }

      band1 = frame : ui.festivalBand {
        bandName {
          contents: "Gojira"
        }

        dayPill {
          dayFace {
            dayLabel {
              contents: "Jeu 17"
            }
          }
        }
      }

      band2 = frame : ui.festivalBand {
        bandName {
          contents: "Idles"
        }

        dayPill {
          dayFace {
            dayLabel {
              contents: "Jeu 17"
            }
          }
        }
      }

      band3 = frame : ui.festivalBand {
        bandName {
          contents: "Mastodon"
        }

        dayPill {
          dayFace {
            dayLabel {
              contents: "Ven 18"
            }
          }
        }
      }

      band4 = frame : ui.festivalBand {
        bandName {
          contents: "Turnstile"
        }

        dayPill {
          dayFace {
            dayLabel {
              contents: "Sam 19"
            }
          }
        }
      }

      addBand = frame : ui.artistAddField {
        fieldValue {
          contents: "Ajouter un groupe et son jour"
        }
      }
    }
  }

  actions = frame : ui.stepActions {
    next {
      connections[0].label: "Suivant",
      connections[0].target: step3.addFestival3
    }
  }
}
