use "fonts/CabinetGrotesk-Variable.ttf"

import "images/hero-cowboy.jpg" as photo
import "icons/lucide/tent.svg" as tentIcon
import "components/redone/onboarding.elyx" as onboarding
import "tokens/colors.elyx" as c
import "tokens/fonts.elyx" as f
import "components/redone/ui.elyx" as ui
import "screens/redone/add-concert.elyx" as addConcert
import "screens/redone/add-festival.elyx" as addFestival

// Onboarding, étape 3 sur 3 : les souvenirs, puis on passe à l'action. Le choix Concert / Festival de l'ajout est directement ici, sans bouton intermédiaire.
export onboarding3 = frame {
  title: "Onboarding 3/3",
  caption: "Dernier écran : « Garde tes souvenirs », puis « Par quoi commencer ? » avec les deux choix de l'étape 1 de l'ajout (Concert, Festival), sans bouton « Ajouter ». Plus de « Passer » : choisir un type est la sortie.",
  left: 0px,
  top: 0px,
  width: 390px,
  height: 844px,
  layout: {direction: .column, justify-content: .space-between},
  fill: [
    {image: {ref: photo}},
    {
      linear-gradient: {
        angle: 180deg,
        stops: [
          stop(0%, rgb(0%, 0%, 0%, 40%)),
          stop(45%, rgb(0%, 0%, 0%, 55%)),
          stop(100%, rgb(0%, 0%, 0%, 92%))
        ]
      }
    }
  ],
  corner-radius: 48px,
  padding: [24px, 20px, 32px],
  children: [top, lower],

  // Dernier écran : le logo reste, « Passer » disparaît.
  top = frame : onboarding.onboardingTop {
    skip {
      display: .none
    }
  }

  // Le vide de 92 px sous les points les garde à la même hauteur que sur les étapes 1 et 2.
  lower = frame {
    width: 100%,
    height: .auto,
    layout: {direction: .column, item-gap: 28px},
    padding: [0px, 0px, 92px],
    children: [content, choices, dotsRow],

    content = frame : onboarding.onboardingContent {
      disc {
        display: .none
      }

      texts {
        stepTitle {
          contents: "Garde tes souvenirs"
        }

        stepBody {
          contents: "Pouces, avis, setlist, photos : tout est gardé dans ton historique."
        }
      }
    }

    choices = frame {
      width: 100%,
      height: .auto,
      layout: {direction: .column, item-gap: 12px},
      children: [heading, concertChoice, festivalChoice],

      heading = text {
        width: 100%,
        fill: c.colors.text-on-dark,
        contents: "Par quoi commencer ?",
        font-size: 22,
        font-family: f.fonts.ui,
        font-style: "Medium",
        letter-spacing: -2%
      }

      concertChoice = frame : ui.typeCard {
        connections[0].label: "Concert",
        connections[0].target: addConcert.addConcert,

        typeTexts {
          typeText {
            contents: "Une soirée, une salle, un à trois groupes."
          }
        }
      }

      festivalChoice = frame : ui.typeCard {
        connections[0].label: "Festival",
        connections[0].target: addFestival.addFestival,

        typeDisc {
          typeGlyph {
            contents: tentIcon
          }
        }

        typeTexts {
          typeText {
            contents: "Un ou plusieurs jours, un line-up réparti par jour."
          }

          typeTitle {
            contents: "Festival"
          }
        }
      }
    }

    dotsRow = frame {
      width: 100%,
      height: .auto,
      layout: {justify-content: .center},
      children: dots,

      dots = frame : onboarding.pageDots3 {}
    }
  }
}
