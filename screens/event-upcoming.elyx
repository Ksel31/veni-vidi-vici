use "fonts/CabinetGrotesk-Variable.ttf"

import "images/bg-event-upcoming.jpg" as bgPhoto
import "components/screen-header.elyx" as headers
import "tokens/colors.elyx" as c
import "tokens/fonts.elyx" as f
import "components/event-card.elyx" as cards
import "icons/lucide/ticket.svg" as ticketIcon
import "components/ui.elyx" as ui
import "icons/lucide/music.svg" as musicIcon
import "screens/event-edit.elyx" as eventEdit
import "icons/lucide/calendar.svg" as calendarIcon
import "icons/lucide/map-pin.svg" as mapPinIcon
import "icons/lucide/mic-vocal.svg" as micIcon
import "icons/lucide/euro.svg" as euroIcon
import "icons/lucide/info.svg" as infoIcon
import "icons/lucide/pencil.svg" as pencilIcon
import "icons/lucide/calendar-plus.svg" as calendarPlusIcon
import "icons/lucide/chevron-down.svg" as chevronDownIcon

// Fiche d'un event à venir : billet, compte à rebours, infos et line-up. Tout se modifie depuis le bouton du bas.
export eventUpcoming = frame {
  title: "Fiche : event à venir",
  caption: "Avant la date : compte à rebours et infos. Le jour même dit « Aujourd'hui », jamais « J-0 ». Rôles en icônes. Sous Modifier : Supprimer. Chaque carte (Infos, Billet, Line-up) se plie et se déplie avec la flèche en haut à droite : dépliée = flèche vers le haut, repliée = seul le titre reste, flèche vers le bas. Ici, Billet est replié en exemple. « Ajouter à mon agenda » (carte Infos, sous le lieu) télécharge cet event en .ics.",
  left: 0px,
  top: 0px,
  width: 390px,
  height: .auto,
  layout: {direction: .column},
  fill: [
    {image: {ref: bgPhoto}},
    {
      linear-gradient: {
        angle: 180deg,
        stops: [
          stop(0%, rgb(0%, 0%, 0%, 40%)),
          stop(40%, rgb(0%, 0%, 0%, 62%)),
          stop(100%, rgb(0%, 0%, 0%, 92%))
        ]
      }
    }
  ],
  corner-radius: 48px,
  padding: [24px, 12px, 40px],
  children: [header, body],

  header = frame : headers.pageHeader {
    padding-top: 8px,
    padding-left: 8px,
    padding-bottom: 0px,
    padding-right: 8px,

    pageTitle {
      contents: "Nick Cave"
    }
  }

  body = frame {
    width: 100%,
    height: .auto,
    layout: {direction: .column, item-gap: 14px},
    padding: [20px, 0px, 0px],
    children: [countdown, ticket, infos, ticketCard, lineup, edit, remove],

    countdown = text {
      width: 100%,
      fill: c.colors.text-on-dark,
      contents: "Dans 4 jours",
      font-size: 36,
      font-family: f.fonts.ui,
      font-style: "Medium",
      line-height: 1,
      letter-spacing: -3%
    }

    ticket = frame : cards.nextTicket {
      ticketInfo {
        eventTitle {
          contents: "NICK CAVE"
        }

        eventMeta {
          contents: "Ancienne Belgique, Bruxelles"
        }
      }
    }

    infos = frame : ui.foldCard {
      overrides: [
        insert(infosHead, after = ui.glassCard.cardTitle),
        insert(dateInfo, after = infosHead),
        insert(venueInfo, after = dateInfo),
        insert(calendarExport, after = venueInfo)
      ],

      cardTitle {
        display: .none,
        contents: "Infos"
      }

      infosHead = frame : ui.cardHead {
        headGlyph {
          contents: infoIcon
        }

        headLabel {
          contents: "Infos"
        }
      }

      dateInfo = frame : ui.field {
        fieldBox {
          fieldGlyph {
            contents: calendarIcon
          }

          fieldValue {
            contents: "Sam 14 novembre 2026"
          }
        }

        fieldLabel {
          contents: "Date"
        }
      }

      venueInfo = frame : ui.field {
        fieldBox {
          fieldGlyph {
            contents: mapPinIcon
          }

          fieldValue {
            contents: "Ancienne Belgique, Bruxelles"
          }
        }

        fieldLabel {
          contents: "Lieu"
        }
      }

      // Export d'un seul event : télécharge un fichier .ics à ouvrir dans son agenda. Pour un festival, un seul événement sur toute la plage de dates.
      calendarExport = frame : ui.secondaryButton {
        height: 44px,

        buttonGlyph {
          contents: calendarPlusIcon
        }

        buttonLabel {
          contents: "Ajouter à mon agenda"
        }
      }
    }

    // Exemple de carte repliée : seul le titre reste, la flèche pointe vers le bas
    ticketCard = frame : ui.foldCard {
      overrides: [
        insert(ticketHead, after = ui.glassCard.cardTitle),
        insert(priceInfo, after = ticketHead),
        insert(ticketFile, after = priceInfo)
      ],

      cardTitle {
        display: .none,
        contents: "Billet"
      }

      foldToggle {
        foldGlyph {
          contents: chevronDownIcon
        }
      }

      ticketHead = frame : ui.cardHead {
        headGlyph {
          contents: ticketIcon
        }

        headLabel {
          contents: "Billet"
        }
      }

      priceInfo = frame : ui.field {
        display: .none,

        fieldBox {
          fieldGlyph {
            contents: euroIcon
          }

          fieldValue {
            contents: "65,00 €"
          }
        }

        fieldLabel {
          contents: "Prix du billet"
        }
      }

      ticketFile = frame : ui.uploadBox {
        display: .none
      }
    }

    lineup = frame : ui.foldCard {
      overrides: [
        insert(lineupHead, after = ui.glassCard.cardTitle),
        insert(headliner, after = lineupHead),
        insert(support, after = headliner)
      ],

      cardTitle {
        display: .none,
        contents: "Line-up"
      }

      lineupHead = frame : ui.cardHead {
        headGlyph {
          contents: musicIcon
        }

        headLabel {
          contents: "Line-up"
        }
      }

      headliner = frame : ui.lineupRow {
        bandRemove {
          display: .none
        }

        bandName {
          contents: "Nick Cave & The Bad Seeds"
        }
      }

      support = frame : ui.lineupRow {
        bandRole {
          fill[0].color: c.colors.glass-strong,
          border[0].color: c.colors.border,

          bandRoleGlyph {
            fill[0].color: c.colors.text-on-dark,
            contents: micIcon
          }
        }

        bandRemove {
          display: .none
        }

        bandName {
          contents: "Cat Power"
        }
      }
    }

    edit = frame : ui.secondaryButton {
      connections[0].label: "Modifier l'event",
      connections[0].target: eventEdit.eventEdit,

      buttonGlyph {
        contents: pencilIcon
      }

      buttonLabel {
        contents: "Modifier l'event"
      }
    }

    remove = frame : ui.dangerButton {}
  }
}
