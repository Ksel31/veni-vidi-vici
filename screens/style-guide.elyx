      houseCell = frame {
        width: 104px,
        height: .auto,
        layout: {direction: .column, align-items: .center, item-gap: 8px},
        children: [houseGlyph, houseLabel],

        houseGlyph = asset {
          width: 32px,
          height: 32px,
          fill: c.colors.ink,
          contents: houseIcon
