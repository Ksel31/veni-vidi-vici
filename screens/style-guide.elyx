        historyCell,
        plusCell,
        calendarCell,
        mapPinCell,
        ticketCell,
        musicCell,
        usersCell,
        thumbsUpCell,
        thumbsDownCell,
        checkCell,
        xCell,
        arrowLeftCell,
        chevronRightCell,
        chevronDownCell
