  shapes = frame {
    width: 100%,
    height: .auto,
    layout: {direction: .column, item-gap: 20px},
    padding: [40px, 32px],
    children: [shapesTitle, radiusRow],

    shapesTitle = text {
      fill: c.colors.text-on-dark,
      contents: "Formes",
      font-size: 32,
      font-family: f.fonts.ui,
      font-style: "Medium"
    }

    radiusRow = frame {
      width: 100%,
      height: .auto,
      layout: {item-gap: 12px},
      children: [r6, r10, r18, r24, r32],

      r6 = frame {
        width: 112px,
        height: .auto,
        layout: {direction: .column, item-gap: 8px},
        padding: 4px,
        children: [r6Chip, r6Label],

        r6Chip = frame {
          width: 100%,
          height: 80px,
          fill: c.colors.glass,
          border: c.colors.text-on-dark,
          corner-radius: 6px
        }

        r6Label = text {
          width: 100%,
          fill: c.colors.text-on-dark,
          contents: "6 px · Pastilles",
          font-size: 13,
          font-family: f.fonts.ui
        }
      }

      r10 = frame {
        width: 112px,
        height: .auto,
        layout: {direction: .column, item-gap: 8px},
        padding: 4px,
