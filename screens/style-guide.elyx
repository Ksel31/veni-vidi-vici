      font-size: 32,
      font-family: f.fonts.ui,
      font-style: "Medium"
    }

    colorsNote = text {
      width: 100%,
      fill: c.colors.text-on-dark,
      contents: "Cinq échelles de 12 steps (méthode Radix Colors). 1-2 fonds · 3-5 composants · 6-8 bordures · 9-10 aplats pleins · 11-12 textes. Le lime n'est jamais un aplat de fond d'écran. Rouge, ambre et vert disent un état, jamais de la décoration.",
      font-size: 16,
      font-family: f.fonts.ui,
      line-height: 1.35
    }

