          corner-radius: l.lengths.radius-l
        }

        pinkSwatchName = text {
          fill: c.colors.text-on-paper,
          contents: "Rose",
          font-size: 16,
          font-family: f.fonts.body,
          font-style: "Bold"
        }

        pinkSwatchHex = text {
          fill: c.colors.text-on-paper,
          contents: "#FF2E88",
          font-size: 14,
          font-family: f.fonts.body
        }

        pinkSwatchRole = text {
          width: 100%,
          fill: c.colors.text-on-paper,
