  effects = frame {
    width: 100%,
    height: .auto,
    layout: {direction: .column, item-gap: 20px},
    padding: [40px, 32px],
    children: [effectsTitle, effectList],

    effectsTitle = text {
      fill: c.colors.text-on-dark,
      contents: "Effets",
      font-size: 32,
      font-family: f.fonts.ui,
      font-style: "Medium"
    }

    effectList = frame {
      width: 100%,
      height: .auto,
      layout: {direction: .column, item-gap: 12px},
      children: [eff0, eff1, eff2, eff3],

      eff0 = frame {
        width: 100%,
        height: .auto,
        layout: {direction: .column, item-gap: 4px},
        fill: c.colors.glass,
        border: c.colors.glass-border,
        corner-radius: l.lengths.radius-xl,
        padding: 16px,
        children: [eff0Title, eff0Text],

        eff0Title = text {
          fill: c.colors.text-on-dark,
          contents: "Verre sombre",
          font-size: 17,
          font-family: f.fonts.ui,
          font-style: "Medium"
        }

        eff0Text = text {
          width: 100%,
          fill: c.colors.text-on-dark,
          contents: "Cartes et barre d'onglets : noir 55 à 80 % avec un filet blanc à 14 %. La photo reste visible derrière.",
          font-size: 14,
          font-family: f.fonts.ui
        }
      }

      eff1 = frame {
        width: 100%,
        height: .auto,
        layout: {direction: .column, item-gap: 4px},
        fill: c.colors.glass,
        border: c.colors.glass-border,
        corner-radius: l.lengths.radius-xl,
        padding: 16px,
        children: [eff1Title, eff1Text],

        eff1Title = text {
          fill: c.colors.text-on-dark,
          contents: "Billet holographique",
          font-size: 17,
          font-family: f.fonts.ui,
          font-style: "Medium"
        }

        eff1Text = text {
          width: 100%,
          fill: c.colors.text-on-dark,
          contents: "Image générée (design/tools/make-ticket-holo.py) : reflet diagonal discret et logo répété en filigrane. Il doit rester vert et le texte noir lisible.",
          font-size: 14,
          font-family: f.fonts.ui
        }
      }

      eff2 = frame {
        width: 100%,
        height: .auto,
        layout: {direction: .column, item-gap: 4px},
        fill: c.colors.glass,
        border: c.colors.glass-border,
        corner-radius: l.lengths.radius-xl,
        padding: 16px,
        children: [eff2Title, eff2Text],

        eff2Title = text {
          fill: c.colors.text-on-dark,
          contents: "Ombre portée",
          font-size: 17,
          font-family: f.fonts.ui,
          font-style: "Medium"
        }

        eff2Text = text {
          width: 100%,
          fill: c.colors.text-on-dark,
          contents: "Sous le billet uniquement : noir 55 %, décalage 10 px, flou 18 px.",
          font-size: 14,
          font-family: f.fonts.ui
        }
      }

      eff3 = frame {
        width: 100%,
        height: .auto,
        layout: {direction: .column, item-gap: 4px},
        fill: c.colors.glass,
        border: c.colors.glass-border,
        corner-radius: l.lengths.radius-xl,
        padding: 16px,
        children: [eff3Title, eff3Text],

        eff3Title = text {
          fill: c.colors.text-on-dark,
          contents: "Fondu noir",
          font-size: 17,
          font-family: f.fonts.ui,
          font-style: "Medium"
        }

        eff3Text = text {
          width: 100%,
          fill: c.colors.text-on-dark,
          contents: "Dégradé du noir vers transparent sous la barre d'onglets, par-dessus la liste.",
          font-size: 14,
          font-family: f.fonts.ui
        }
      }
    }
  }

  components = frame {
    width: 100%,
    height: .auto,
    layout: {direction: .column, item-gap: 28px},
    fill: [
      {
        image: {
          ref: componentsPhoto,
          sizing: {scale: 0.24, offset: [0px, -272.6951px]}
        }
      },
      {
        linear-gradient: {
          angle: 180deg,
          stops: [
            stop(0%, rgb(0%, 0%, 0%, 70%)),
            stop(100%, rgb(0%, 0%, 0%, 92%))
          ]
        }
      }
    ],
    corner-radius: [0px, 0px, 24px, 24px],
    padding: [40px, 32px, 56px],
    children: [
      componentsTitle,
      ticketGroup,
      pillGroup,
      rowGroup,
      profileGroup,
      headerGroup,
      navGroup
    ],

    componentsTitle = text {
      fill: c.colors.text-on-dark,
      contents: "Composants",
      font-size: 32,
      font-family: f.fonts.ui,
      font-style: "Medium"
    }

    ticketGroup = frame {
      width: 100%,
      height: .auto,
      layout: {direction: .column, item-gap: 12px},
      children: [ticketGroupLabel, ticketSample],

      ticketGroupLabel = text {
        fill: c.colors.text-on-dark,
        contents: "nextTicket · le billet du prochain event",
        font-size: 14,
        font-family: f.fonts.ui
      }

      ticketSample = frame : cards.nextTicket {
        ticketInfo {
          eventTitle {
            contents: "NICK CAVE"
          }

          eventMeta {
            contents: "ANCIENNE BELGIQUE, BRUXELLES"
          }
        }
      }
    }

    pillGroup = frame {
      width: 100%,
      height: .auto,
      layout: {direction: .column, item-gap: 12px},
      children: [pillGroupLabel, pillRow],

      pillGroupLabel = text {
        fill: c.colors.text-on-dark,
        contents: "ticketPill · confirmPill · searchButton",
        font-size: 14,
        font-family: f.fonts.ui
      }

      pillRow = frame {
        width: .auto,
        height: .auto,
        layout: {align-items: .center, item-gap: 24px},
        children: [ticketPillSample, confirmSample, searchSample],

        ticketPillSample = frame : cards.ticketPill {}

        confirmSample = frame : cards.confirmPill {}

        searchSample = frame : profileParts.searchButton {}
      }
    }

    rowGroup = frame {
      width: 100%,
      height: .auto,
      layout: {direction: .column, item-gap: 12px},
      children: [rowGroupLabel, rowSample],

      rowGroupLabel = text {
        fill: c.colors.text-on-dark,
        contents: "eventRow · ligne d'event à venir (verre sombre)",
        font-size: 14,
        font-family: f.fonts.ui
      }

      rowSample = frame : cards.eventRow {
        info {
          eventMeta {
            contents: "Forest National, Bruxelles"
          }

          eventTitle {
            contents: "Ghost"
          }
        }
      }
    }

    profileGroup = frame {
      width: 100%,
      height: .auto,
      layout: {direction: .column, item-gap: 12px},
      children: [profileGroupLabel, profileSample2],

      profileGroupLabel = text {
        fill: c.colors.text-on-dark,
        contents: "profileHeader · avatar, recherche, trois chiffres clés, déconnexion",
        font-size: 14,
        font-family: f.fonts.ui
      }

      profileSample2 = frame : profileParts.profileHeader {}
    }

    headerGroup = frame {
      width: 100%,
      height: .auto,
      layout: {direction: .column, item-gap: 12px},
      children: [headerGroupLabel, headerSample],

      headerGroupLabel = text {
        fill: c.colors.text-on-dark,
        contents: "pageHeader · retour + titre d'un écran secondaire",
        font-size: 14,
        font-family: f.fonts.ui
      }

      headerSample = frame : headers.pageHeader {
        padding-top: 0px,
        padding-left: 6px,
        padding-bottom: 0px,
        padding-right: 6px
      }
    }

    navGroup = frame {
      width: 100%,
      height: .auto,
      layout: {direction: .column, item-gap: 12px},
      children: [navGroupLabel, navRow],

      navGroupLabel = text {
        fill: c.colors.text-on-dark,
        contents: "tabBar · addButton",
        font-size: 14,
        font-family: f.fonts.ui
      }

      navRow = frame {
        width: 100%,
        height: .auto,
        layout: {justify-content: .space-between, align-items: .center},
        children: [tabSample, addSample],

        tabSample = frame : nav.tabBar {}

        addSample = frame : nav.addButton {}
      }
    }
  }
}
