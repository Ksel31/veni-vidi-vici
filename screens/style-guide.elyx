          font-family: f.fonts.ui
        }
      }

      musicCell = frame {
        width: 104px,
        height: .auto,
        layout: {direction: .column, align-items: .center, item-gap: 8px},
        children: [musicGlyph, musicLabel],

        musicGlyph = asset {
          width: 32px,
          height: 32px,
          fill: c.colors.ink,
          contents: musicIcon
        }

        musicLabel = text {
          fill: c.colors.ink,
          contents: "Groupe",
          font-size: 14,
          font-family: f.fonts.ui
        }
      }

      usersCell = frame {
        width: 104px,
        height: .auto,
        layout: {direction: .column, align-items: .center, item-gap: 8px},
        children: [usersGlyph, usersLabel],

        usersGlyph = asset {
          width: 32px,
          height: 32px,
          fill: c.colors.ink,
          contents: usersIcon
        }

        usersLabel = text {
          fill: c.colors.ink,
          contents: "Accompagnants",
          font-size: 14,
          font-family: f.fonts.ui
        }
      }

      thumbsUpCell = frame {
        width: 104px,
        height: .auto,
        layout: {direction: .column, align-items: .center, item-gap: 8px},
        children: [thumbsUpGlyph, thumbsUpLabel],

        thumbsUpGlyph = asset {
          width: 32px,
