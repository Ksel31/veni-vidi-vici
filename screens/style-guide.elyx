// Style guide Veni Vidi Vici : palette, typographies, icônes, formes, effets et composants (instances vivantes du design system).
// Règles : interface sombre sur photo de concert ; le vert est rare (billet, « + », alerte) ; texte en Cabinet Grotesk Regular ou Medium seulement ;
// Wagon uniquement pour les grands chiffres du billet ; icônes Lucide à trait de 2 px.
export styleGuide = frame {
  title: "Style guide",
  caption: "Palette, typographies, icônes Lucide, formes, effets et composants de Veni Vidi Vici.",
  left: 540px,
  top: 0px,
  width: 720px,
  height: .auto,
  layout: {direction: .column},
  fill: c.colors.neutral-1,
  corner-radius: 24px,
  children: [
    header,
    colors,
    states,
    typography,
    icons,
    shapes,
    effects,
    components
  ],

  header = frame {
    width: 100%,
    height: .auto,
    layout: {justify-content: .space-between, align-items: .center},
    fill: [
      {
        image: {
          ref: headerPhoto,
          sizing: {scale: 0.2368, offset: [0px, -207.09px]}
        }
      },
      {
        linear-gradient: {
          angle: 180deg,
          stops: [
            stop(0%, rgb(0%, 0%, 0%, 35%)),
            stop(100%, c.colors.neutral-1)
          ]
        }
      }
    ],
    padding: [64px, 32px, 40px],
    children: [headerLogo, headerTitle],

    headerLogo = asset {
      width: 180px,
      height: 64px,
      contents: logoImage
    }

    headerTitle = text {
      fill: c.colors.text-on-dark,
      contents: "Style guide",
      font-size: 40,
      font-family: f.fonts.ui,
      font-style: "Medium",
      letter-spacing: -3%
    }
  }

  colors = frame {
    width: 100%,
