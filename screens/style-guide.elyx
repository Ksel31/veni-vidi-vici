      font-size: 44,
      font-family: f.fonts.display
    }

    hefanaNote = text {
      width: 100%,
      fill: c.colors.text-on-paper,
      contents: "ROYAL Hefana, pour les titres. Toujours en capitales et inclinée à 11°, car la police n'a pas d'italique.",
      font-size: 14,
      font-family: f.fonts.body
    }

    archivoSpecimen = text {
      width: 100%,
      fill: c.colors.text-on-paper,
