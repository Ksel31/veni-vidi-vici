      font-family: f.fonts.ui
    }

    brandSpecimen = text {
      transform: [1, -0.2, 18, 0, 1, 0],
      fill: c.colors.ink,
      contents: "VENI VIDI VICI",
      font-size: 44,
      font-family: f.fonts.brand
    }

    brandNote = text {
      width: 100%,
      fill: c.colors.ink,
      contents: "ROYAL Hefana, réservée au logo et au branding. Trop fine pour de l'interface. Capitales uniquement, inclinée à 11° car la police n'a pas d'italique.",
      font-size: 14,
      font-family: f.fonts.ui
    }

    sizesNote = text {
      width: 100%,
      fill: c.colors.ink,
      contents: "Tailles : titre d'écran 28, titre de carte 18, texte 16, texte secondaire 14. Jamais en dessous de 14.",
      font-size: 14,
      font-family: f.fonts.ui
    }
  }

  icons = frame {
