      layout: {item-gap: l.lengths.space-m},
      children: [pinkSwatch, inkSwatch, paperSwatch],

      pinkSwatch = frame {
        width: 208px,
        height: .auto,
        layout: {direction: .column, item-gap: 8px},
        children: [
          pinkSwatchChip,
          pinkSwatchName,
          pinkSwatchHex,
          pinkSwatchRole
        ],

        pinkSwatchChip = frame {
          width: 100%,
