// Style guide : palette, typographies, icônes (Lucide) et formes. Inspiré des refs « Heavy Metal ».
export styleGuide = frame {
  title: "Style guide",
  caption: "Palette, typographies, icônes Lucide et formes de Veni Vidi Vici.",
  left: 0px,
  top: 0px,
  width: 720px,
  height: .auto,
  layout: {direction: .column},
  fill: c.colors.surface-paper,
  children: [header, colors, typography, icons, shapes],

  header = frame {
    width: 100%,
    height: .auto,
    layout: {},
    fill: c.colors.surface-pink,
    padding: [48px, 24px],
    children: headerTitle,

    headerTitle = text {
      transform: [1, -0.2, 17, 0, 1, 0],
      fill: c.colors.text-on-pink,
      contents: "STYLE GUIDE",
      font-size: 72,
      font-family: f.fonts.display
    }
  }

  colors = frame {
    width: 100%,
    height: .auto,
    layout: {direction: .column, item-gap: l.lengths.space-m},
    padding: l.lengths.space-l,
    children: [colorsTitle, colorRow],

    colorsTitle = text {
      transform: [1, -0.2, 10, 0, 1, 0],
      fill: c.colors.text-on-paper,
      contents: "COULEURS",
      font-size: 40,
      font-family: f.fonts.display
    }

    colorRow = frame {
      width: 100%,
