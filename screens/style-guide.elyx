use "fonts/ROYALHefanaRegular.woff"
use "fonts/Archivo.ttf"

import "tokens/colors.elyx" as c
import "tokens/lengths.elyx" as l
import "tokens/fonts.elyx" as f
import "icons/lucide/house.svg" as houseIcon
import "icons/lucide/history.svg" as historyIcon
import "icons/lucide/plus.svg" as plusIcon
import "icons/lucide/calendar.svg" as calendarIcon
import "icons/lucide/map-pin.svg" as mapPinIcon
import "icons/lucide/ticket.svg" as ticketIcon
import "icons/lucide/music.svg" as musicIcon
import "icons/lucide/users.svg" as usersIcon
import "icons/lucide/thumbs-up.svg" as thumbsUpIcon
import "icons/lucide/thumbs-down.svg" as thumbsDownIcon
import "icons/lucide/check.svg" as checkIcon
import "icons/lucide/x.svg" as xIcon
import "icons/lucide/arrow-left.svg" as arrowLeftIcon
import "icons/lucide/chevron-right.svg" as chevronRightIcon
import "icons/lucide/chevron-down.svg" as chevronDownIcon

// Style guide : palette, typographies, icônes (Lucide), formes et composants.
// Règles : un écran = une intention ; le fond et les cartes ne sont jamais de la couleur d'action ;
// l'encre est l'action secondaire ; la police de marque ne sert que pour le logo.
export styleGuide = frame {
  title: "Style guide",
  caption: "Palette, typographies, icônes Lucide, formes et composants de Veni Vidi Vici.",
  left: 0px,
  top: 1100px,
  width: 720px,
  height: .auto,
  layout: {direction: .column},
  fill: c.colors.paper,
  children: [header, colors, typography, icons, shapes],

  header = frame {
    width: 100%,
    height: .auto,
    layout: {direction: .row},
    fill: c.colors.brand,
    padding: [48px, 24px],
    children: headerTitle,

    headerTitle = text {
      transform: [1, -0.2, 17, 0, 1, 0],
      fill: c.colors.ink,
      contents: "VENI VIDI VICI",
      font-size: 72,
      font-family: f.fonts.brand
    }
  }

  colors = frame {
    width: 100%,
    height: .auto,
    layout: {direction: .column, item-gap: l.lengths.space-m},
    padding: l.lengths.space-l,
    children: [colorsTitle, colorsNote, colorRow],

    colorsTitle = text {
      fill: c.colors.ink,
      contents: "Couleurs",
      font-size: 28,
      font-family: f.fonts.ui,
      font-style: "Bold"
    }

    colorsNote = text {
      width: 100%,
      fill: c.colors.ink,
      contents: "Le fond d'écran et les cartes ne sont jamais de la couleur d'action : le rose est le fond d'écran et la marque, l'encre porte les actions.",
      font-size: 16,
      font-family: f.fonts.ui
    }

    colorRow = frame {
      width: 100%,
      height: .auto,
      layout: {item-gap: l.lengths.space-m},
      children: [pinkSwatch, inkSwatch, paperSwatch, whiteSwatch],

      pinkSwatch = frame {
        width: 156px,
        height: .auto,
        layout: {direction: .column, item-gap: 8px},
        children: [
          pinkSwatchChip,
          pinkSwatchName,
          pinkSwatchHex,
          pinkSwatchRole
        ],

        pinkSwatchChip = frame {
          width: 100%,
          height: 96px,
          fill: c.colors.pink,
          corner-radius: l.lengths.radius-l
        }

        pinkSwatchName = text {
          fill: c.colors.ink,
          contents: "Rose",
          font-size: 16,
          font-family: f.fonts.ui,
          font-style: "Bold"
        }

        pinkSwatchHex = text {
          fill: c.colors.ink,
          contents: "#FF0088",
          font-size: 14,
          font-family: f.fonts.ui
        }

        pinkSwatchRole = text {
          width: 100%,
          fill: c.colors.ink,
          contents: "Fond d'écran, marque.",
          font-size: 14,
          font-family: f.fonts.ui
        }
      }

      inkSwatch = frame {
        width: 156px,
        height: .auto,
        layout: {direction: .column, item-gap: 8px},
        children: [inkSwatchChip, inkSwatchName, inkSwatchHex, inkSwatchRole],

        inkSwatchChip = frame {
          width: 100%,
          height: 96px,
          fill: c.colors.ink,
          corner-radius: l.lengths.radius-l
        }

        inkSwatchName = text {
          fill: c.colors.ink,
          contents: "Encre",
          font-size: 16,
          font-family: f.fonts.ui,
          font-style: "Bold"
        }

        inkSwatchHex = text {
          fill: c.colors.ink,
          contents: "#2B1118",
          font-size: 14,
          font-family: f.fonts.ui
        }

        inkSwatchRole = text {
          width: 100%,
          fill: c.colors.ink,
          contents: "Texte, icônes, actions.",
          font-size: 14,
          font-family: f.fonts.ui
        }
      }

      paperSwatch = frame {
        width: 156px,
        height: .auto,
        layout: {direction: .column, item-gap: 8px},
        children: [
          paperSwatchChip,
          paperSwatchName,
          paperSwatchHex,
          paperSwatchRole
        ],

        paperSwatchChip = frame {
          width: 100%,
          height: 96px,
          fill: c.colors.paper,
          border: c.colors.ink,
          corner-radius: l.lengths.radius-l
        }

        paperSwatchName = text {
          fill: c.colors.ink,
          contents: "Papier",
          font-size: 16,
          font-family: f.fonts.ui,
          font-style: "Bold"
        }

        paperSwatchHex = text {
          fill: c.colors.ink,
          contents: "#F5F1EA",
          font-size: 14,
          font-family: f.fonts.ui
        }

        paperSwatchRole = text {
          width: 100%,
          fill: c.colors.ink,
          contents: "Pastilles d'information.",
          font-size: 14,
          font-family: f.fonts.ui
        }
      }

      whiteSwatch = frame {
        width: 156px,
        height: .auto,
        layout: {direction: .column, item-gap: 8px},
        children: [
          whiteSwatchChip,
          whiteSwatchName,
          whiteSwatchHex,
          whiteSwatchRole
        ],

        whiteSwatchChip = frame {
          width: 100%,
          height: 96px,
          fill: c.colors.white,
          border: c.colors.ink,
          corner-radius: l.lengths.radius-l
        }

        whiteSwatchName = text {
          fill: c.colors.ink,
          contents: "Blanc",
          font-size: 16,
          font-family: f.fonts.ui,
          font-style: "Bold"
        }

        whiteSwatchHex = text {
          fill: c.colors.ink,
          contents: "#FFFFFF",
          font-size: 14,
          font-family: f.fonts.ui
        }

        whiteSwatchRole = text {
          width: 100%,
          fill: c.colors.ink,
          contents: "Cartes et barre du bas.",
          font-size: 14,
          font-family: f.fonts.ui
        }
      }
    }
  }

  typography = frame {
    width: 100%,
    height: .auto,
    layout: {direction: .column, item-gap: l.lengths.space-m},
    padding: l.lengths.space-l,
    children: [
      typoTitle,
      uiSpecimenTitle,
      uiSpecimen,
      uiNote,
      brandSpecimen,
      brandNote,
      sizesNote
    ],

    typoTitle = text {
      fill: c.colors.ink,
      contents: "Typographies",
      font-size: 28,
      font-family: f.fonts.ui,
      font-style: "Bold"
    }

    uiSpecimenTitle = text {
      width: 100%,
      fill: c.colors.ink,
      contents: "Titre d'écran en Archivo gras",
      font-size: 28,
      font-family: f.fonts.ui,
      font-style: "Bold"
    }

    uiSpecimen = text {
      width: 100%,
      fill: c.colors.ink,
      contents: "Ancienne Belgique, Bruxelles. AaBbCcDdEeFfGgHhIiJjKkLlMmNnOoPpQqRrSsTtUuVvWwXxYyZz 0123456789",
      font-size: 16,
      font-family: f.fonts.ui
    }

    uiNote = text {
      width: 100%,
      fill: c.colors.ink,
      contents: "Archivo, pour tous les titres et tous les textes de l'interface. Regular pour le texte, Bold pour les titres, les noms et les boutons.",
