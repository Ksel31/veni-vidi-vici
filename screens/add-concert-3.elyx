use "fonts/CabinetGrotesk-Variable.ttf"

import "images/bg-add-concert.jpg" as bgPhoto
import "components/screen-header.elyx" as headers
import "components/ui.elyx" as ui
import "icons/lucide/plus.svg" as plusIcon
import "icons/lucide/euro.svg" as euroIcon
import "screens/event-upcoming.elyx" as eventUpcoming
import "screens/event-report.elyx" as eventReport

// Ajout d'un concert, étape 3/3 : le billet (acheté, prix, fichier), tout facultatif. Dernière étape = enregistrement.
// Date à venir → fiche de l'event ; date passée → présence pré-sélectionnée sur « Vu », direct au compte rendu.
export addConcert3 = frame {
  title: "Ajouter un concert, étape 3/3",
  caption: "Dernière étape : le bouton principal enregistre. Date à venir → fiche ; date passée → « Vu » d'office, compte rendu.",
  left: 0px,
  top: 0px,
  width: 390px,
  height: 844px,
  layout: {direction: .column, justify-content: .space-between},
  fill: [
    {image: {ref: bgPhoto}},
    {
      linear-gradient: {
        angle: 180deg,
        stops: [
          stop(0%, rgb(0%, 0%, 0%, 60%)),
          stop(40%, rgb(0%, 0%, 0%, 72%)),
          stop(100%, rgb(0%, 0%, 0%, 92%))
        ]
      }
    }
  ],
  corner-radius: 48px,
  padding: [24px, 12px, 32px],
  children: [top, actions],

  top = frame {
    width: 100%,
    height: .auto,
    layout: {direction: .column, item-gap: 20px},
    children: [header, intro, card],

    header = frame : headers.pageHeader {
      padding-top: 8px,
      padding-left: 8px,
      padding-bottom: 0px,
      padding-right: 8px,

      pageTitle {
        contents: "Nouveau concert"
      }
    }

    intro = frame : ui.stepHeader {
      stepLabel {
        contents: "Étape 3/3"
      }

      stepTitle {
        contents: "Et le billet ?"
      }

      stepHelp {
        contents: "Tout est facultatif, tu pourras le compléter depuis la fiche."
      }

      stepTrack {
        stepFill {
          width: 350px
        }
      }
    }

    card = frame : ui.glassCard {
      overrides: [
        insert(ticketBought, after = ui.glassCard.cardTitle),
        insert(ticketPrice, after = ticketBought),
        insert(ticketUpload, after = ticketPrice)
      ],

      cardTitle {
        display: .none
      }

      ticketBought = frame : ui.checkRow {
        checkTexts {
          checkTitle {
            contents: "Billet acheté"
          }

          checkMeta {
            contents: "Affiche la pastille sur la liste et le billet."
          }
        }
      }

      ticketPrice = frame : ui.field {
        fieldBox {
          fieldGlyph {
            contents: euroIcon
          }

          fieldValue {
            contents: "65,00"
          }
        }

        fieldLabel {
          contents: "Prix du billet"
        }
      }

      ticketUpload = frame : ui.uploadBox {}
    }
  }

  actions = frame : ui.stepActions {
    next {
      connections[0].target: eventUpcoming.eventUpcoming,
      connections[1].target: eventReport.eventReport,
      connections[0].label: "Date à venir",
      connections[1].label: "Date passée : « Vu » d'office",

      buttonGlyph {
        contents: plusIcon,
        display: .visible
      }

      buttonLabel {
        contents: "Ajouter le concert"
      }
    }
  }
}
