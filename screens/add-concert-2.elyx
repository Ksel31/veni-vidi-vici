use "fonts/CabinetGrotesk-Variable.ttf"

import "images/bg-add-concert.jpg" as bgPhoto
import "components/screen-header.elyx" as headers
import "tokens/colors.elyx" as c
import "tokens/fonts.elyx" as f
import "components/ui.elyx" as ui
import "icons/lucide/x.svg" as closeIcon
import "screens/add-concert-3.elyx" as step3
import "screens/add-exit.elyx" as exit

// Ajout d'un concert, étape 2/3 : les groupes. Étape facultative, ici encore vide : le bouton dit « Passer ».
export addConcert2 = frame {
  title: "Ajouter un concert, étape 2/3",
  caption: "Refonte : tant que rien n'est ajouté, le bouton dit « Passer » (il dit « Suivant » dès qu'un groupe est là). La croix ouvre une confirmation avant de perdre la saisie.",
  left: 0px,
  top: 0px,
  width: 390px,
  height: .auto,
  min-height: 844px,
  layout: {direction: .column, justify-content: .space-between},
  fill: [
    {image: {ref: bgPhoto}},
    {
      linear-gradient: {
        angle: 180deg,
        stops: [
          stop(0%, rgb(0%, 0%, 0%, 78%)),
          stop(40%, rgb(0%, 0%, 0%, 80%)),
          stop(100%, rgb(0%, 0%, 0%, 92%))
        ]
      }
    }
  ],
  corner-radius: 48px,
  padding: [24px, 12px, 32px],
  children: [top, actions],

  top = frame {
    width: 100%,
    height: .auto,
    layout: {direction: .column, item-gap: 20px},
    children: [header, intro, card],

    header = frame : headers.pageHeader {
      padding-top: 8px,
      padding-left: 8px,
      padding-bottom: 0px,
      padding-right: 8px,

      backButton {
        connections[0].label: "Fermer",
        connections[0].target: exit.addExit,

        glyph {
          contents: closeIcon
        }
      }

      pageTitle {
        contents: "Nouveau concert"
      }
    }

    intro = frame : ui.stepHeader {
      stepLabel {
        contents: "Étape 2/3"
      }

      stepTrack {
        stepFill {
          width: 233px
        }
      }

      stepTitle {
        contents: "Qui joue ?"
      }

      stepHelp {
        contents: "Ajoute la tête d'affiche et, si tu veux, les premières parties."
      }
    }

    card = frame : ui.glassCard {
      overrides: [
        insert(zoneHead, after = ui.glassCard.cardTitle),
        insert(zoneSupport, after = zoneHead)
      ],

      cardTitle {
        display: .none
      }

      zoneHead = frame {
        width: 100%,
        height: .auto,
        layout: {direction: .column, item-gap: 8px},
        overflow: .visible,
        children: [zoneLabel, addHead],

        zoneLabel = text {
          width: 100%,
          fill: c.colors.text-on-dark-muted,
          contents: "Tête d'affiche",
          font-size: 13,
          font-family: f.fonts.ui,
          font-style: "Medium"
        }

        addHead = frame : ui.artistAddField {}
      }

      zoneSupport = frame {
        width: 100%,
        height: .auto,
        layout: {direction: .column, item-gap: 8px},
        overflow: .visible,
        children: [zoneLabel, addSupport],

        zoneLabel = text {
          width: 100%,
          fill: c.colors.text-on-dark-muted,
          contents: "Première partie",
          font-size: 13,
          font-family: f.fonts.ui,
          font-style: "Medium"
        }

        addSupport = frame : ui.artistAddField {}
      }
    }
  }

  actions = frame : ui.stepActions {
    next {
      connections[0].label: "Passer",
      connections[0].target: step3.addConcert3,

      buttonLabel {
        contents: "Passer"
      }
    }
  }
}
