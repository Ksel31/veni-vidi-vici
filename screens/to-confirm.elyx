use "fonts/CabinetGrotesk-Variable.ttf"

import "images/bg-to-confirm.jpg" as bgPhoto
import "components/screen-header.elyx" as headers
import "components/ui.elyx" as ui
import "screens/event-confirm.elyx" as eventConfirm
import "screens/event-festival.elyx" as eventFestival

// À confirmer : events passés restés « prévus ». Une réponse par carte, « Vu » ou « Raté ».
// Un concert se confirme sur sa fiche ; un festival demande en plus les jours et les groupes.
export toConfirm = frame {
  title: "À confirmer",
  caption: "Accès depuis la pastille de l'accueil. Chaque carte mène à la fiche de l'event pour répondre.",
  left: 0px,
  top: 0px,
  width: 390px,
  height: 844px,
  layout: {direction: .column},
  fill: [
    {image: {ref: bgPhoto}},
    {
      linear-gradient: {
        angle: 180deg,
        stops: [
          stop(0%, rgb(0%, 0%, 0%, 50%)),
          stop(40%, rgb(0%, 0%, 0%, 58%)),
          stop(100%, rgb(0%, 0%, 0%, 78%))
        ]
      }
    }
  ],
  corner-radius: 48px,
  padding: [24px, 12px, 0px],
  children: [header, body],

  header = frame : headers.pageHeader {
    padding-top: 8px,
    padding-left: 8px,
    padding-bottom: 0px,
    padding-right: 8px,

    pageTitle {
      contents: "À confirmer"
    }
  }

  body = frame {
    width: 100%,
    height: .auto,
    layout: {direction: .column, item-gap: 14px},
    padding: [24px, 8px, 0px],
    children: [intro, concertCard, festivalCard],

    intro = text : ui.hint {
      contents: "2 events sont passés. Dis-nous si tu y étais."
    }

    concertCard = frame : ui.pendingCard {
      connections[0].label: "Ouvrir la fiche",
      connections[0].target: eventConfirm.eventConfirm,

      head {
        info {
          eventMeta {
            contents: "Concert, Botanique, Bruxelles"
          }

          eventTitle {
            contents: "Wolves in the Throne Room"
          }
        }

        dateBlock {
          dateMonth {
            contents: "OCT"
          }

          dateDay {
            contents: "28"
          }
        }
      }
    }

    festivalCard = frame : ui.pendingCard {
      connections[0].label: "Vu : jours et groupes",
      connections[0].target: eventFestival.eventFestival,

      head {
        info {
          eventMeta {
            contents: "Festival, 2 jours, Anvers"
          }

          eventTitle {
            contents: "Desertfest Belgium"
          }
        }

        dateBlock {
          dateMonth {
            contents: "OCT"
          }

          dateDay {
            contents: "17"
          }
        }
      }
    }
  }
}
