use "fonts/CabinetGrotesk-Variable.ttf"

import "images/bg-event-festival.jpg" as bgPhoto
import "components/screen-header.elyx" as headers
import "tokens/colors.elyx" as c
import "tokens/fonts.elyx" as f
import "components/ui.elyx" as ui
import "icons/lucide/x.svg" as crossIcon
import "icons/lucide/pencil.svg" as pencilIcon
import "screens/event-report.elyx" as eventReport
import "screens/event-edit-festival.elyx" as eventEditFestival

// Fiche d'un festival passé, encore « prévu » : on coche les jours faits, puis les groupes vus parmi ces jours.
// Les groupes non cochés passent en « raté ». Un jour décoché retire ses groupes de la liste.
export eventFestival = frame {
  title: "Fiche : confirmer un festival",
  caption: "Après la date : jours faits, puis groupes vus. Le statut est sous le nom. Le bouton dit « Confirmer », à côté de « Raté ». Pas de second bouton de confirmation en bas.",
  left: 0px,
  top: 0px,
  width: 390px,
  height: .auto,
  layout: {direction: .column},
  fill: [
    {image: {ref: bgPhoto}},
    {
      linear-gradient: {
        angle: 180deg,
        stops: [
          stop(0%, rgb(0%, 0%, 0%, 55%)),
          stop(40%, rgb(0%, 0%, 0%, 72%)),
          stop(100%, rgb(0%, 0%, 0%, 92%))
        ]
      }
    }
  ],
  corner-radius: 48px,
  padding: [24px, 12px, 40px],
  children: [header, body],

  header = frame : headers.pageHeader {
    padding-top: 8px,
    padding-left: 8px,
    padding-bottom: 0px,
    padding-right: 8px,

    pageTitle {
      contents: "Fiche de l'event"
    }
  }

  body = frame {
    width: 100%,
    height: .auto,
    layout: {direction: .column, item-gap: 14px},
    padding: [24px, 8px, 0px],
    children: [identity, days, saturday, sunday, answers, edit, remove],

    identity = frame {
      width: 100%,
      height: .auto,
      layout: {direction: .column, item-gap: 8px},
      padding: [0px, 6px],
      children: [eventTitle, eventMeta, badge],

      eventTitle = text {
        width: 100%,
        fill: c.colors.text-on-dark,
        contents: "Desertfest Belgium",
        font-size: 36,
        font-family: f.fonts.ui,
        font-style: "Medium",
        line-height: 1.05,
        letter-spacing: -3%
      }

      eventMeta = text {
        width: 100%,
        fill: c.colors.text-on-dark-muted,
        contents: "Festival, 17 et 18 octobre 2026, Anvers",
        font-size: 14,
        font-family: f.fonts.ui,
        font-style: "Regular"
      }

      badge = frame : ui.statusBadgePending {}
    }

    days = frame : ui.glassCard {
      overrides: [
        insert(daySat, after = ui.glassCard.cardTitle),
        insert(daySun, after = daySat)
      ],

      cardTitle {
        contents: "1. Quels jours ?"
      }

      daySat = frame : ui.checkRow {
        checkTexts {
          checkTitle {
            contents: "Samedi 17 octobre"
          }

          checkMeta {
            contents: "3 groupes à voir"
          }
        }
      }

      daySun = frame : ui.checkRowOff {
        checkTexts {
          checkTitle {
            contents: "Dimanche 18 octobre"
          }

          checkMeta {
            contents: "3 groupes à voir"
          }
        }
      }
    }

    saturday = frame : ui.glassCard {
      overrides: [
        insert(satBand1, after = ui.glassCard.cardTitle),
        insert(satBand2, after = satBand1),
        insert(satBand3, after = satBand2)
      ],

      cardTitle {
        contents: "2. Samedi : groupes vus"
      }

      satBand1 = frame : ui.checkRow {
        checkTexts {
          checkMeta {
            display: .none
          }

          checkTitle {
            contents: "Truckfighters"
          }
        }
      }

      satBand2 = frame : ui.checkRow {
        checkTexts {
          checkMeta {
            display: .none
          }

          checkTitle {
            contents: "Nebula"
          }
        }
      }

      satBand3 = frame : ui.checkRowOff {
        checkTexts {
          checkMeta {
            display: .none
          }

          checkTitle {
            contents: "Elder"
          }
        }
      }
    }

    sunday = frame : ui.glassCard {
      overrides: [insert(sunNote, after = ui.glassCard.cardTitle)],

      cardTitle {
        contents: "Dimanche : jour non fait"
      }

      sunNote = text : ui.hint {
        contents: "Ses 3 groupes passeront en « raté »."
      }
    }

    answers = frame {
      width: 100%,
      height: .auto,
      layout: {item-gap: 12px},
      children: [missed, confirm],

      missed = frame : ui.secondaryButton {
        buttonGlyph {
          contents: crossIcon
        }

        buttonLabel {
          contents: "Raté"
        }
      }

      confirm = frame : ui.primaryButton {
        connections[0].label: "Confirmer : compte rendu",
        connections[0].target: eventReport.eventReport,

        buttonLabel {
          contents: "Confirmer"
        }
      }
    }

    edit = frame : ui.secondaryButton {
      connections[0].label: "Modifier l'event",
      connections[0].target: eventEditFestival.eventEditFestival,

      buttonGlyph {
        contents: pencilIcon
      }

      buttonLabel {
        contents: "Modifier l'event"
      }
    }

    remove = frame : ui.dangerButton {}
  }
}
