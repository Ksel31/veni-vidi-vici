use "fonts/CabinetGrotesk-Variable.ttf"

import "screens/signup.elyx" as signupScreen
import "tokens/colors.elyx" as c

// Inscription avec deux erreurs de saisie : nom d'utilisateur déjà pris, mots de passe différents.
// Même principe que les autres formulaires : filet rouge + message sous le champ (icône + texte, jamais la couleur seule).
export signupError = frame : signupScreen.signup {
  title: "Inscription, erreurs",
  caption: "Erreurs de saisie : filet rouge sur le champ, message dessous qui dit comment corriger. Nom déjà pris : en proposer un autre. Mots de passe différents : les retaper. Le bouton reste actif ; les erreurs s'affichent à l'envoi.",

  form {
    fields {
      usernameBlock {
        usernameField {
          fieldBox {
            border[0].color: c.colors.danger-text
          }
        }

        usernameError {
          messageText {
            contents: "Ce nom d'utilisateur est déjà pris. Essaie-en un autre."
          }

          display: .visible
        }
      }

      confirmBlock {
        confirmField {
          fieldBox {
            border[0].color: c.colors.danger-text
          }
        }

        confirmError {
          display: .visible
        }
      }
    }
  }
}
