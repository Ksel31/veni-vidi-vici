use "fonts/Archivo.ttf"

import "components/screen-header.elyx" as headers
import "tokens/colors.elyx" as c
import "tokens/lengths.elyx" as l
import "tokens/fonts.elyx" as f
import "components/tab-bar.elyx" as nav
import "icons/lucide/plus.svg" as plusIcon

// Accueil au premier lancement : aucun event. Une seule action principale.
export homeEmpty = frame {
  title: "Accueil, premier lancement",
  caption: "Aucun event enregistré",
  left: 0px,
  top: 0px,
  width: 390px,
  height: 844px,
  layout: {direction: .column},
  fill: c.colors.surface-screen,
  corner-radius: 48px,
  children: [header, content, tabs],

  header = frame : headers.brandHeader {
    padding-top: 56px
  }

  tabs = frame : nav.tabBar {
    left: 20px,
    bottom: 32px,
    ignore-stack: .true
  }

  content = frame {
    width: 100%,
    height: 100%,
    layout: {direction: .column, justify-content: .center, item-gap: 32px},
    padding: [0px, 20px, 110px],
    children: [message, addButton],

    message = frame {
      width: 100%,
      height: .auto,
      layout: {direction: .column, item-gap: 12px},
      fill: c.colors.surface-card,
      corner-radius: l.lengths.radius-l,
      padding: l.lengths.space-l,
      children: [emptyTitle, emptyText],

      emptyTitle = text {
        width: 100%,
        fill: c.colors.ink,
        contents: "Rien en vue pour l'instant",
        font-size: 28,
        font-family: f.fonts.ui,
        font-style: "Bold"
      }

      emptyText = text {
        width: 100%,
        fill: c.colors.ink,
        contents: "Ajoute un concert ou un festival, à venir ou déjà vu. Tes prochains events et ton historique s'afficheront ici.",
        font-size: 16,
        font-family: f.fonts.ui,
        line-height: 1.4
      }
    }

    addButton = frame {
      width: 100%,
      height: 56px,
      layout: {justify-content: .center, align-items: .center, item-gap: 8px},
      fill: c.colors.action,
      corner-radius: l.lengths.radius-l,
      children: [plus, addLabel],

      plus = asset {
        width: 24px,
        height: 24px,
        fill: c.colors.on-action,
        contents: plusIcon
      }

      addLabel = text {
        fill: c.colors.on-action,
        contents: "Ajouter un concert",
        font-size: 16,
        font-family: f.fonts.ui,
        font-style: "Bold"
      }
    }
  }
}
