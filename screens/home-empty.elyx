use "fonts/ROYALHefanaRegular.woff"
use "fonts/Archivo.ttf"

import "icons/lucide/plus.svg" as addIcon
import "tokens/colors.elyx" as c
import "tokens/lengths.elyx" as l
import "tokens/fonts.elyx" as f

// Accueil au premier lancement : aucun event. Une seule action principale.
homeEmpty = frame {
  title: "Accueil, premier lancement",
  caption: "Aucun event enregistré",
  left: 0px,
  top: 0px,
  width: 390px,
  height: 844px,
  layout: {direction: .column},
  fill: c.colors.surface-screen,
  children: [header, content],

  header = frame {
    width: 100%,
    height: .auto,
    layout: {align-items: .center},
    padding: [24px, 20px, 8px],
    children: appName,

    appName = text {
      transform: [1, -0.2, 8, 0, 1, 0],
      fill: c.colors.ink,
      contents: "VENI VIDI VICI",
      font-size: 36,
      font-family: f.fonts.display
    }
  }

  content = frame {
    width: 100%,
    height: 100%,
    layout: {direction: .column, justify-content: .center, item-gap: 32px},
    padding: [0px, 20px, 120px],
    children: [message, addButton],

    message = frame {
      width: 100%,
      height: .auto,
      layout: {direction: .column, item-gap: 12px},
      fill: c.colors.surface-card,
      corner-radius: l.lengths.radius-l,
      padding: l.lengths.space-l,
      children: [emptyTitle, emptyText],

      emptyTitle = text {
        width: 100%,
        transform: [1, -0.2, 10, 0, 1, 0],
        fill: c.colors.ink,
        contents: "AUCUN EVENT POUR L'INSTANT",
        font-size: 36,
        font-family: f.fonts.display
      }

      emptyText = text {
        width: 100%,
        fill: c.colors.ink,
        contents: "Ajoute un concert ou un festival, à venir ou déjà vu. Tes prochains events et ton historique s'afficheront ici.",
        font-size: 16,
        font-family: f.fonts.body,
        line-height: 1.4
      }
    }

    addButton = frame {
      width: 100%,
      height: 56px,
      layout: {justify-content: .center, align-items: .center, item-gap: 8px},
      fill: c.colors.ink,
      corner-radius: l.lengths.radius-l,
      children: [plus, addLabel],

      plus = asset {
        width: 24px,
        height: 24px,
        fill: c.colors.paper,
        contents: addIcon
      }

      addLabel = text {
        fill: c.colors.paper,
        contents: "Ajouter mon premier event",
        font-size: 16,
        font-family: f.fonts.body,
        font-style: "Bold"
      }
    }
  }
}
