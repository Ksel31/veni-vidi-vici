use "fonts/CabinetGrotesk-Variable.ttf"

import "images/bg-add-concert.jpg" as bgPhoto
import "components/screen-header.elyx" as headers
import "tokens/colors.elyx" as c
import "components/ui.elyx" as ui
import "icons/lucide/music.svg" as musicIcon
import "icons/lucide/plus.svg" as plusIcon
import "screens/event-upcoming.elyx" as eventUpcoming
import "icons/lucide/calendar.svg" as calendarIcon
import "icons/lucide/map-pin.svg" as mapPinIcon
import "icons/lucide/euro.svg" as euroIcon
import "screens/event-report.elyx" as eventReport

// Ajout d'un concert : date, lieu, groupes (tête d'affiche / première partie), billet.
// Date à venir → fiche de l'event ; date passée → présence pré-sélectionnée sur « Vu », direct au compte rendu.
export addConcert = frame {
  title: "Ajouter un concert",
  caption: "Étape 2. Lieu et groupes s'autocomplètent sur ce qui existe déjà, sinon ils sont créés à la volée.",
  left: 0px,
  top: 0px,
  width: 390px,
  height: .auto,
  layout: {direction: .column},
  fill: [
    {image: {ref: bgPhoto}},
    {
      linear-gradient: {
        angle: 180deg,
        stops: [
          stop(0%, rgb(0%, 0%, 0%, 60%)),
          stop(40%, rgb(0%, 0%, 0%, 72%)),
          stop(100%, rgb(0%, 0%, 0%, 92%))
        ]
      }
    }
  ],
  corner-radius: 48px,
  padding: [24px, 12px, 40px],
  children: [header, body],

  header = frame : headers.pageHeader {
    padding-top: 8px,
    padding-left: 8px,
    padding-bottom: 0px,
    padding-right: 8px,

    pageTitle {
      contents: "Nouveau concert"
    }
  }

  body = frame {
    width: 100%,
    height: .auto,
    layout: {direction: .column, item-gap: 14px},
    padding: [20px, 8px, 0px],
    children: [whenWhere, bands, ticket, submit],

    whenWhere = frame : ui.glassCard {
      overrides: [
        insert(dateField, after = ui.glassCard.cardTitle),
        insert(venueField, after = dateField),
        insert(titleField, after = venueField)
      ],

      cardTitle {
        contents: "Quand et où"
      }

      dateField = frame : ui.field {
        fieldBox {
          fieldGlyph {
            contents: calendarIcon
          }

          fieldValue {
            contents: "Sam 14 novembre 2026"
          }
        }

        fieldLabel {
          contents: "Date"
        }
      }

      venueField = frame : ui.field {
        fieldBox {
          fieldGlyph {
            contents: mapPinIcon
          }

          fieldValue {
            contents: "Ancienne Belgique, Bruxelles"
          }
        }

        fieldLabel {
          contents: "Lieu"
        }
      }

      titleField = frame : ui.fieldEmpty {
        fieldBox {
          fieldGlyph {
            contents: musicIcon
          }

          fieldValue {
            contents: "Ex. soirée anniversaire"
          }
        }

        fieldLabel {
          contents: "Titre (optionnel)"
        }
      }
    }

    bands = frame : ui.glassCard {
      overrides: [
        insert(headliner, after = ui.glassCard.cardTitle),
        insert(support, after = headliner),
        insert(addBand, after = support)
      ],

      cardTitle {
        contents: "Groupes"
      }

      headliner = frame : ui.lineupRow {
        bandName {
          contents: "Nick Cave"
        }
      }

      support = frame : ui.lineupRow {
        bandRole {
          fill[0].color: c.colors.glass-strong,
          border[0].color: c.colors.border,

          bandRoleLabel {
            fill[0].color: c.colors.text-on-dark,
            contents: "Première partie"
          }
        }

        bandName {
          contents: "Cat Power"
        }
      }

      addBand = frame : ui.fieldEmpty {
        fieldLabel {
          display: .none
        }

        fieldBox {
          fieldGlyph {
            contents: plusIcon
          }

          fieldValue {
            contents: "Ajouter un groupe"
          }
        }
      }
    }

    ticket = frame : ui.glassCard {
      overrides: [
        insert(ticketBought, after = ui.glassCard.cardTitle),
        insert(ticketPrice, after = ticketBought),
        insert(ticketUpload, after = ticketPrice)
      ],

      cardTitle {
        contents: "Billet"
      }

      ticketPrice = frame : ui.field {
        fieldBox {
          fieldGlyph {
            contents: euroIcon
          }

          fieldValue {
            contents: "65,00 €"
          }
        }

        fieldLabel {
          contents: "Prix du billet"
        }
      }

      ticketUpload = frame : ui.uploadBox {}

      ticketBought = frame : ui.checkRow {
        checkTexts {
          checkTitle {
            contents: "Billet acheté"
          }

          checkMeta {
            contents: "Affiche la pastille sur la liste et le billet."
          }
        }
      }
    }

    submit = frame : ui.primaryButton {
      connections[0].label: "Date à venir",
      connections[0].target: eventUpcoming.eventUpcoming,
      connections[1].label: "Date passée : « Vu » d'office",
      connections[1].target: eventReport.eventReport,

      buttonGlyph {
        contents: plusIcon
      }

      buttonLabel {
        contents: "Ajouter le concert"
      }
    }
  }
}
