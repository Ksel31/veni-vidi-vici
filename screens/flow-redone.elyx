noteAddConcert = frame : notes.note {
  left: 1700px,
  top: 3140px,

  noteBody {
    contents: "1. Croix « Fermer » à la place de la flèche\n2. Astérisques supprimés, « (optionnel) » écrit sur Ville, Salle, Titre\n3. Icône bâtiment pour « Lieu, salle »\n4. Dégradé plus dense, 78 % en haut ; champs en Archivo Regular, plus Light\n5. Écran en hauteur minimale, actions ancrées en bas"
  }
}

