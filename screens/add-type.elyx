use "fonts/CabinetGrotesk-Variable.ttf"

import "images/bg-add-type.jpg" as bgPhoto
import "components/screen-header.elyx" as headers
import "tokens/colors.elyx" as c
import "tokens/fonts.elyx" as f
import "components/ui.elyx" as ui
import "screens/add-concert.elyx" as addConcert
import "screens/add-festival.elyx" as addFestival
import "icons/lucide/tent.svg" as tentIcon

// Ajout, étape 1 : le type d'event se choisit en premier, parce qu'il change le formulaire de l'étape 2.
export addType = frame {
  title: "Ajouter, étape 1",
  caption: "Concert ou festival : le choix décide des champs de l'étape suivante.",
  left: 0px,
  top: 0px,
  width: 390px,
  height: 844px,
  layout: {direction: .column},
  fill: [
    {image: {ref: bgPhoto}},
    {
      linear-gradient: {
        angle: 180deg,
        stops: [
          stop(0%, rgb(0%, 0%, 0%, 55%)),
          stop(40%, rgb(0%, 0%, 0%, 50%)),
          stop(100%, rgb(0%, 0%, 0%, 75%))
        ]
      }
    }
  ],
  corner-radius: 48px,
  padding: [24px, 12px, 0px],
  children: [header, body],

  header = frame : headers.pageHeader {
    padding-top: 8px,
    padding-left: 8px,
    padding-bottom: 0px,
    padding-right: 8px,

    pageTitle {
      contents: "Ajouter"
    }
  }

  body = frame {
    width: 100%,
    height: .auto,
    layout: {direction: .column, item-gap: 16px},
    padding: [48px, 8px, 0px],
    children: [question, concertChoice, festivalChoice],

    question = text {
      width: 100%,
      fill: c.colors.text-on-dark,
      contents: "Quel type d'event ?",
      font-size: 36,
      font-family: f.fonts.ui,
      line-height: 1,
      letter-spacing: -3%
    }

    concertChoice = frame : ui.typeCard {
      connections[0].label: "Concert",
      connections[0].target: addConcert.addConcert,

      typeTexts {
        typeText {
          contents: "Une soirée, une salle, un à trois groupes."
        }
      }
    }

    festivalChoice = frame : ui.typeCard {
      connections[0].label: "Festival",
      connections[0].target: addFestival.addFestival,

      typeDisc {
        typeGlyph {
          contents: tentIcon
        }
      }

      typeTexts {
        typeText {
          contents: "Un ou plusieurs jours, un line-up réparti par jour."
        }

        typeTitle {
          contents: "Festival"
        }
      }
    }
  }
}
