use "fonts/CabinetGrotesk-Variable.ttf"

import "images/bg-event-edit.jpg" as bgPhoto
import "components/screen-header.elyx" as headers
import "tokens/colors.elyx" as c
import "components/ui.elyx" as ui
import "icons/lucide/check.svg" as checkIcon
import "icons/lucide/plus.svg" as plusIcon
import "icons/lucide/calendar.svg" as calendarIcon
import "icons/lucide/map-pin.svg" as mapPinIcon
import "icons/lucide/euro.svg" as euroIcon

// Modifier l'event : même formulaire que l'ajout, pré-rempli. Date, lieu, groupes, billet : tout est modifiable.
// Si la date repasse dans le futur, l'event redevient « prévu » ; si elle est passée, il attend sa confirmation.
export eventEdit = frame {
  title: "Modifier l'event",
  caption: "Accès depuis la fiche. Même formulaire que l'ajout, pré-rempli avec l'event existant.",
  left: 0px,
  top: 0px,
  width: 390px,
  height: .auto,
  layout: {direction: .column},
  fill: [
    {image: {ref: bgPhoto}},
    {
      linear-gradient: {
        angle: 180deg,
        stops: [
          stop(0%, rgb(0%, 0%, 0%, 62%)),
          stop(40%, rgb(0%, 0%, 0%, 74%)),
          stop(100%, rgb(0%, 0%, 0%, 92%))
        ]
      }
    }
  ],
  corner-radius: 48px,
  padding: [24px, 12px, 40px],
  children: [header, body],

  header = frame : headers.pageHeader {
    padding-top: 8px,
    padding-left: 8px,
    padding-bottom: 0px,
    padding-right: 8px,

    pageTitle {
      contents: "Modifier l'event"
    }
  }

  body = frame {
    width: 100%,
    height: .auto,
    layout: {direction: .column, item-gap: 14px},
    padding: [20px, 8px, 0px],
    children: [whenWhere, bands, ticket, note, submit],

    whenWhere = frame : ui.glassCard {
      overrides: [
        insert(dateField, after = ui.glassCard.cardTitle),
        insert(venueField, after = dateField)
      ],

      cardTitle {
        contents: "Quand et où"
      }

      dateField = frame : ui.field {
        fieldBox {
          fieldGlyph {
            contents: calendarIcon
          }

          fieldValue {
            contents: "Sam 14 novembre 2026"
          }
        }

        fieldLabel {
          contents: "Date"
        }
      }

      venueField = frame : ui.field {
        fieldBox {
          fieldGlyph {
            contents: mapPinIcon
          }

          fieldValue {
            contents: "Ancienne Belgique, Bruxelles"
          }
        }

        fieldLabel {
          contents: "Lieu"
        }
      }
    }

    bands = frame : ui.glassCard {
      overrides: [
        insert(headliner, after = ui.glassCard.cardTitle),
        insert(support, after = headliner),
        insert(addBand, after = support)
      ],

      cardTitle {
        contents: "Groupes"
      }

      headliner = frame : ui.lineupRow {
        bandName {
          contents: "Nick Cave"
        }
      }

      support = frame : ui.lineupRow {
        bandRole {
          fill[0].color: c.colors.glass-strong,
          border[0].color: c.colors.border,

          bandRoleLabel {
            fill[0].color: c.colors.text-on-dark,
            contents: "Première partie"
          }
        }

        bandName {
          contents: "Cat Power"
        }
      }

      addBand = frame : ui.fieldEmpty {
        fieldLabel {
          display: .none
        }

        fieldBox {
          fieldGlyph {
            contents: plusIcon
          }

          fieldValue {
            contents: "Ajouter un groupe"
          }
        }
      }
    }

    ticket = frame : ui.glassCard {
      overrides: [
        insert(ticketBought, after = ui.glassCard.cardTitle),
        insert(ticketPrice, after = ticketBought),
        insert(ticketUpload, after = ticketPrice)
      ],

      cardTitle {
        contents: "Billet"
      }

      ticketPrice = frame : ui.field {
        fieldBox {
          fieldGlyph {
            contents: euroIcon
          }

          fieldValue {
            contents: "65,00 €"
          }
        }

        fieldLabel {
          contents: "Prix du billet"
        }
      }

      ticketUpload = frame : ui.fileRow {
        fileTexts {
          fileName {
            contents: "nick-cave-billet.pdf"
          }
        }
      }

      ticketBought = frame : ui.checkRow {
        checkTexts {
          checkTitle {
            contents: "Billet acheté"
          }

          checkMeta {
            contents: "Coche quand tu l'as en poche."
          }
        }
      }
    }

    note = text : ui.hint {
      contents: "Si tu repousses la date dans le futur, l'event redevient « prévu »."
    }

    submit = frame : ui.primaryButton {
      buttonGlyph {
        contents: checkIcon
      }

      buttonLabel {
        contents: "Enregistrer"
      }
    }
  }
}
