use "fonts/CabinetGrotesk-Variable.ttf"

import "images/bg-event-edit.jpg" as bgPhoto
import "components/screen-header.elyx" as headers
import "tokens/colors.elyx" as c
import "tokens/fonts.elyx" as f
import "components/ui.elyx" as ui
import "icons/lucide/check.svg" as checkIcon
import "icons/lucide/calendar.svg" as calendarIcon
import "icons/lucide/map-pin.svg" as mapPinIcon
import "icons/lucide/mic-vocal.svg" as micIcon
import "icons/lucide/music.svg" as musicIcon
import "icons/lucide/euro.svg" as euroIcon

// Modifier un concert : même formulaire que l'ajout, pré-rempli. Le festival a sa planche, screens/event-edit-festival.elyx.
// Si la date repasse à aujourd'hui ou plus tard, l'event redevient prévu.
export eventEdit = frame {
  title: "Modifier l'event",
  caption: "Accès depuis la fiche. Même formulaire que l'ajout : ville puis salle, groupes sous chaque rôle. « Supprimer l'event » ouvre la question dans la page.",
  left: 0px,
  top: 0px,
  width: 390px,
  height: .auto,
  layout: {direction: .column},
  fill: [
    {image: {ref: bgPhoto}},
    {
      linear-gradient: {
        angle: 180deg,
        stops: [
          stop(0%, rgb(0%, 0%, 0%, 62%)),
          stop(40%, rgb(0%, 0%, 0%, 74%)),
          stop(100%, rgb(0%, 0%, 0%, 92%))
        ]
      }
    }
  ],
  corner-radius: 48px,
  padding: [24px, 12px, 40px],
  children: [header, body],

  header = frame : headers.pageHeader {
    padding-top: 8px,
    padding-left: 8px,
    padding-bottom: 0px,
    padding-right: 8px,

    pageTitle {
      contents: "Modifier l'event"
    }
  }

  body = frame {
    width: 100%,
    height: .auto,
    layout: {direction: .column, item-gap: 14px},
    padding: [20px, 8px, 0px],
    children: [required, whenWhere, bands, ticket, note, submit, remove],

    required = text : ui.hint {
      contents: "* Obligatoire"
    }

    whenWhere = frame : ui.glassCard {
      overrides: [
        insert(dateField, after = ui.glassCard.cardTitle),
        insert(cityField, after = dateField),
        insert(roomField, after = cityField),
        insert(titleField, after = roomField)
      ],

      cardTitle {
        contents: "Quand et où"
      }

      dateField = frame : ui.field {
        fieldBox {
          fieldGlyph {
            contents: calendarIcon
          }

          fieldValue {
            contents: "14 nov. 2026"
          }
        }

        fieldLabel {
          contents: "Date *"
        }
      }

      cityField = frame : ui.field {
        fieldBox {
          fieldGlyph {
            contents: mapPinIcon
          }

          fieldValue {
            contents: "Bruxelles"
          }
        }

        fieldLabel {
          contents: "Ville"
        }
      }

      roomField = frame : ui.field {
        fieldBox {
          fieldGlyph {
            contents: mapPinIcon
          }

          fieldValue {
            contents: "Ancienne Belgique"
          }
        }

        fieldLabel {
          contents: "Lieu, salle"
        }
      }

      titleField = frame : ui.field {
        fieldBox {
          fieldGlyph {
            contents: musicIcon
          }

          fieldValue {
            contents: "Nick Cave"
          }
        }

        fieldLabel {
          contents: "Titre (optionnel)"
        }
      }
    }

    bands = frame : ui.glassCard {
      overrides: [
        insert(zoneHead, after = ui.glassCard.cardTitle),
        insert(zoneSupport, after = zoneHead)
      ],

      cardTitle {
        contents: "Groupes"
      }

      zoneHead = frame {
        width: 100%,
        height: .auto,
        layout: {direction: .column, item-gap: 8px},
        overflow: .visible,
        children: [zoneLabel, headliner, addHead],

        zoneLabel = text {
          width: 100%,
          fill: c.colors.text-on-dark-muted,
          contents: "Tête d'affiche",
          font-size: 13,
          font-family: f.fonts.ui,
          font-style: "Medium"
        }

        headliner = frame : ui.lineupRow {
          padding: [10px, 12px],

          dragHandle {
            display: .visible
          }

          bandName {
            contents: "Nick Cave"
          }
        }

        addHead = frame : ui.artistAddField {}
      }

      zoneSupport = frame {
        width: 100%,
        height: .auto,
        layout: {direction: .column, item-gap: 8px},
        overflow: .visible,
        children: [zoneLabel, support, addSupport],

        zoneLabel = text {
          width: 100%,
          fill: c.colors.text-on-dark-muted,
          contents: "Première partie",
          font-size: 13,
          font-family: f.fonts.ui,
          font-style: "Medium"
        }

        support = frame : ui.lineupRow {
          padding: [10px, 12px],

          dragHandle {
            display: .visible
          }

          bandRole {
            fill[0].color: c.colors.glass-strong,
            border[0].color: c.colors.border,

            bandRoleGlyph {
              fill[0].color: c.colors.text-on-dark,
              contents: micIcon
            }
          }

          bandName {
            contents: "Cat Power"
          }
        }

        addSupport = frame : ui.artistAddField {}
      }
    }

    ticket = frame : ui.glassCard {
      overrides: [
        insert(ticketBought, after = ui.glassCard.cardTitle),
        insert(ticketPrice, after = ticketBought),
        insert(ticketUpload, after = ticketPrice)
      ],

      cardTitle {
        contents: "Billet"
      }

      ticketPrice = frame : ui.field {
        fieldBox {
          fieldGlyph {
            contents: euroIcon
          }

          fieldValue {
            contents: "65,00"
          }
        }

        fieldLabel {
          contents: "Prix du billet"
        }
      }

      ticketUpload = frame : ui.uploadBox {}

      ticketBought = frame : ui.checkRow {
        checkTexts {
          checkTitle {
            contents: "Billet acheté"
          }

          checkMeta {
            contents: "Coche quand tu l'as en poche."
          }
        }
      }
    }

    note = text : ui.hint {
      contents: "Si la date repasse à aujourd'hui ou plus tard, l'event redevient prévu."
    }

    submit = frame : ui.primaryButton {
      buttonGlyph {
        contents: checkIcon
      }

      buttonLabel {
        contents: "Enregistrer"
      }
    }

    remove = frame : ui.secondaryButton {
      buttonGlyph {
        display: .none
      }

      buttonLabel {
        contents: "Supprimer l'event"
      }
    }
  }
}
