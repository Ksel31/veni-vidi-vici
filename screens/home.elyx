use "fonts/CabinetGrotesk-Variable.ttf"

import "images/hero-concert.jpg" as heroPhoto
import "components/event-card.elyx" as cards
import "tokens/colors.elyx" as c
import "tokens/fonts.elyx" as f
import "components/profile.elyx" as profileParts
import "components/tab-bar.elyx" as nav
import "screens/event-upcoming.elyx" as eventUpcoming
import "screens/to-confirm.elyx" as toConfirm
import "screens/history.elyx" as history
import "screens/add-type.elyx" as addType

// Accueil : photo de concert plein écran sous un voile sombre, profil et chiffres clés, billet vert pour le prochain event,
// cartes en verre sombre pour la suite. Tout est assemblé à partir des composants du design system.
export home = frame {
  title: "Accueil",
  caption: "Profil, prochain event en billet, events à venir, et un accès direct aux events à confirmer.",
  left: 0px,
  top: 0px,
  width: 390px,
  height: 844px,
  layout: {direction: .column},
  fill: [
    {image: {ref: heroPhoto}},
    {
      linear-gradient: {
        angle: 180deg,
        stops: [
          stop(0%, rgb(0%, 0%, 0%, 45%)),
          stop(38%, rgb(0%, 0%, 0%, 55%)),
          stop(75%, rgb(0%, 0%, 0%, 92%))
        ]
      }
    }
  ],
  corner-radius: 48px,
  padding: [24px, 12px, 0px],
  children: [profile, nextBlock, upcoming, bottomFade, tabs, addButton],

  profile = frame : profileParts.profileHeader {}

  // Prochain event : titre de section + billet
  nextBlock = frame {
    width: 100%,
    height: .auto,
    layout: {direction: .column, item-gap: 14px},
    padding: [24px, 0px, 0px],
    children: [nextTitle, ticket],

    nextTitle = text {
      width: 100%,
      fill: c.colors.text-on-dark,
      contents: "Dans 4 jours",
      font-size: 36,
      font-family: f.fonts.ui,
      line-height: 1,
      letter-spacing: -3%
    }

    ticket = frame : cards.nextTicket {
      connections[0].label: "Ouvrir la fiche",
      connections[0].target: eventUpcoming.eventUpcoming,

      ticketInfo {
        eventMeta {
          contents: "ANCIENNE BELGIQUE, BRUXELLES"
        }

        eventTitle {
          contents: "NICK CAVE"
        }
      }
    }
  }

  upcoming = frame {
    width: 100%,
    height: .auto,
    layout: {direction: .column, item-gap: 12px},
    padding: [56px, 0px, 0px],
    children: [upcomingTitle, confirmRow, row2, row3],

    upcomingTitle = text {
      width: 100%,
      fill: c.colors.text-on-dark,
      contents: "Events à venir",
      font-size: 36,
      font-family: f.fonts.ui,
      line-height: 1,
      letter-spacing: -3%
    }

    confirmRow = frame {
      width: 100%,
      height: .auto,
      layout: {direction: .row},
      padding: [0px, 6px],
      children: confirmBadge,

      confirmBadge = frame : cards.confirmPill {
        connections[0].label: "À confirmer",
        connections[0].target: toConfirm.toConfirm
      }
    }

    row2 = frame : cards.eventRow {
      info {
        eventMeta {
          contents: "Forest National, Bruxelles"
        }

        eventTitle {
          contents: "Ghost"
        }
      }
    }

    row3 = frame : cards.eventRow {
      info {
        eventMeta {
          contents: "Festival, 4 jours, Werchter"
        }

        eventTitle {
          contents: "Rock Werchter"
        }
      }

      dateBlock {
        dateMonth {
          contents: "JUIL"
        }

        dateDay {
          contents: "17"
        }
      }

      countdown {
        countdownLabel {
          contents: "J-249"
        }
      }
    }
  }

  // Fondu noir sous la barre d'onglets : détache les contrôles des cartes qui défilent derrière
  bottomFade = frame {
    left: 0px,
    bottom: 0px,
    width: 100%,
    height: 190px,
    ignore-stack: .true,
    fill: {
      linear-gradient: {
        angle: 180deg,
        stops: [
          stop(0%, rgb(6.7%, 6.7%, 6.7%, 0%)),
          stop(70%, rgb(6.7%, 6.7%, 6.7%, 92%))
        ]
      }
    }
  }

  tabs = frame : nav.tabBar {
    left: 20px,
    bottom: 32px,
    ignore-stack: .true,

    tabHistory {
      connections[0].target: history.history,
      connections[0].label: "Historique"
    }
  }

  addButton = frame : nav.addButton {
    right: 20px,
    bottom: 32px,
    ignore-stack: .true,
    connections[0].label: "Ajouter",
    connections[0].target: addType.addType
  }
}
