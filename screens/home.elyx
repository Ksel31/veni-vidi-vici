use "fonts/Archivo.ttf"

import "components/event-card.elyx" as cards
import "components/screen-header.elyx" as headers
import "components/tab-bar.elyx" as nav
import "tokens/colors.elyx" as c
import "tokens/lengths.elyx" as l
import "tokens/fonts.elyx" as f

// Accueil : une seule intention, voir ce qui arrive. Le bandeau rose mène à « À confirmer ».
export home = frame {
  title: "Accueil",
  caption: "Les events à venir, et un accès direct aux events à confirmer.",
  left: 0px,
  top: 0px,
  width: 390px,
  height: 844px,
  layout: {direction: .column},
  fill: c.colors.surface-screen,
  children: [header, content, tabs],

  header = frame : headers.brandHeader {}

  content = frame {
    width: 100%,
    height: 100%,
    layout: {direction: .column, item-gap: l.lengths.space-m},
    padding: [20px, 20px, 0px],
    children: [banner, upcomingTitle, row1, row2, row3],

    banner = frame : cards.confirmBanner {}

    upcomingTitle = text {
      width: 100%,
      fill: c.colors.ink,
      contents: "À venir",
      font-size: 28,
      font-family: f.fonts.ui,
      font-style: "Bold"
    }

    row1 = frame : cards.eventCard {
      countdown {
        countdownLabel {
          contents: "Dans 4 jours"
        }
      }

      info {
        eventTitle {
          contents: "Nick Cave"
        }

        eventMeta {
          contents: "Concert | 14 novembre | Ancienne Belgique, Bruxelles"
        }

        ticketState {
          contents: "Billet acheté"
        }
      }
    }

    row2 = frame : cards.eventCard {
      countdown {
        countdownLabel {
          contents: "Dans 32 jours"
        }
      }

      info {
        eventTitle {
          contents: "Ghost"
        }

        eventMeta {
          contents: "Concert | 12 décembre | Forest National, Bruxelles"
        }

        ticketState {
          contents: "Billet non acheté"
        }
      }
    }

    row3 = frame : cards.eventCard {
      countdown {
        countdownLabel {
          contents: "Dans 249 jours"
        }
      }

      info {
        eventTitle {
          contents: "Rock Werchter"
        }

        eventMeta {
          contents: "Festival, 4 jours | 17 au 20 juillet | Werchter"
        }

        ticketState {
          contents: "Billet non acheté"
        }
      }
    }
  }

  tabs = frame : nav.tabBar {}
}
